diff --git a/lib/src/analysis/auth_failure.rs b/lib/src/analysis/auth_failure.rs
new file mode 100644
index 0000000..3f5d559
--- /dev/null
+++ b/lib/src/analysis/auth_failure.rs
@@ -0,0 +1,151 @@
+//! Flags authentication failures and rejects that indicate the network could
+//! not run a valid EPS-AKA exchange -- the signature of a false base station
+//! that has no access to the subscriber's home keys (HSS) and therefore cannot
+//! produce a valid authentication token (AUTN).
+//!
+//! - The UE sends an `Authentication Failure` (uplink) when the AUTN it received
+//!   fails verification: EMM cause #20 (MAC failure -- the AUTN's integrity code
+//!   is wrong, i.e. a forged or invalid challenge), #21 (synch failure -- a
+//!   replayed/old vector, or a genuine SQN desynchronisation), or #26 (non-EPS
+//!   authentication unacceptable).
+//! - The network sends an `Authentication Reject` (downlink) when it cannot
+//!   validate the UE's response; on a home network with a valid USIM this should
+//!   not happen.
+//!
+//! #20 (MAC failure) on a home network is close to impossible without an attack
+//! or a broken SIM (High). #21 occurs legitimately after an SQN resync (followed
+//! immediately by a successful re-authentication) and on SIM swaps, so it is
+//! Medium. An `Authentication Reject` is High. Keys on the message/cause alone
+//! (no state). Causal and low false-positive, but off by default until
+//! calibrated, since a genuine resync or an unprovisioned/invalid SIM can fire
+//! it. See TS 24.301 5.4.2; the Devilray study and prior CSS literature.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use pycrate_rs::nas::NASMessage;
+use pycrate_rs::nas::emm::EMMMessage;
+use pycrate_rs::nas::generated::emm::emm_authentication_failure::EMMCauseEMMCause as AuthFailureCause;
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct AuthFailureAnalyzer;
+
+impl Analyzer for AuthFailureAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Authentication failure or reject")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags a NAS Authentication Failure (EMM cause #20 MAC failure, #21 synch failure, or \
+             #26 non-EPS authentication unacceptable) or an Authentication Reject. A false base \
+             station with no access to the subscriber's home keys cannot produce a valid AUTN, so \
+             the USIM rejects the challenge (#20 especially) or the network rejects the response. \
+             #20 on a home network is near-impossible without an attack or a broken SIM (High); #21 \
+             can be a genuine SQN resync or a SIM swap (Medium); an Authentication Reject is High. \
+             Keys on the message/cause alone.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::NAS(NASMessage::EMMMessage(emm)) = lte.as_ref() else {
+            return None;
+        };
+        match emm {
+            EMMMessage::EMMAuthenticationFailure(failure) => {
+                let (severity, cause) = match failure.emm_cause.inner {
+                    AuthFailureCause::MACFailure => (EventType::High, "#20 (MAC failure)"),
+                    AuthFailureCause::SynchFailure => (EventType::Medium, "#21 (synch failure)"),
+                    AuthFailureCause::NonEPSAuthenticationUnacceptable => (
+                        EventType::Medium,
+                        "#26 (non-EPS authentication unacceptable)",
+                    ),
+                    _ => return None,
+                };
+                Some(Event {
+                    event_type: severity,
+                    message: format!("Authentication Failure with EMM cause {cause}"),
+                })
+            }
+            EMMMessage::EMMAuthenticationReject(_) => Some(Event {
+                event_type: EventType::High,
+                message:
+                    "Authentication Reject: the network rejected the UE's authentication (a home \
+                     network with a valid USIM should not do this)"
+                        .to_string(),
+            }),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, emm_message, packet_time};
+
+    // EMM message type identifiers (TS 24.301 table 9.8.1).
+    const AUTHENTICATION_REJECT: u8 = 84;
+    const AUTHENTICATION_FAILURE: u8 = 92;
+    // EMM cause values.
+    const CAUSE_MAC_FAILURE: u8 = 20;
+    const CAUSE_SYNCH_FAILURE: u8 = 21;
+    const CAUSE_NON_EPS_AUTH_UNACCEPTABLE: u8 = 26;
+    const CAUSE_CONGESTION: u8 = 22;
+
+    fn run(message_type: u8, body: &[u8]) -> Vec<(usize, Event)> {
+        let mut analyzer = AuthFailureAnalyzer;
+        collect_events(
+            &mut analyzer,
+            &[(emm_message(message_type, body), packet_time(0))],
+        )
+    }
+
+    #[test]
+    fn mac_failure_is_high() {
+        let events = run(AUTHENTICATION_FAILURE, &[CAUSE_MAC_FAILURE]);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+    }
+
+    #[test]
+    fn synch_and_non_eps_failures_are_medium() {
+        for cause in [CAUSE_SYNCH_FAILURE, CAUSE_NON_EPS_AUTH_UNACCEPTABLE] {
+            let events = run(AUTHENTICATION_FAILURE, &[cause]);
+            assert_eq!(events.len(), 1, "cause {cause}");
+            assert_eq!(events[0].1.event_type, EventType::Medium);
+        }
+    }
+
+    #[test]
+    fn other_failure_causes_are_ignored() {
+        assert!(run(AUTHENTICATION_FAILURE, &[CAUSE_CONGESTION]).is_empty());
+    }
+
+    #[test]
+    fn authentication_reject_is_high() {
+        let events = run(AUTHENTICATION_REJECT, &[]);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+    }
+
+    #[test]
+    fn unrelated_emm_message_is_ignored() {
+        // An Identity Request (type 85) is EMM but neither a failure nor a reject.
+        assert!(run(85, &[0x01]).is_empty());
+    }
+}
