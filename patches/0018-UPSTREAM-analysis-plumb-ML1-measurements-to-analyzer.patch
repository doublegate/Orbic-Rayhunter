+    /// Reports a physical-layer (ML1) serving/neighbor cell measurement to the
+    /// analyzer: PCI, EARFCN and RSRP, carrying no subscriber identity. These do
+    /// not arrive as an [`InformationElement`] (they are not RRC/NAS), so an
+    /// analyzer that correlates cell identity or signal strength over a recording
+    /// consumes them here.
+    ///
+    /// The default implementation delegates to [`Self::report_skipped_packet`],
+    /// so a time-based analyzer that does not care about measurements keeps
+    /// advancing its clock on these packets with no extra work. An analyzer that
+    /// DOES override this handles the ML1 packet exactly once; if it also needs
+    /// the time tick it should call `self.report_skipped_packet(timestamp)`.
+    fn report_measurement(
+        &mut self,
+        _measurement: &Ml1Measurement,
+        _packet_num: usize,
+        timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        self.report_skipped_packet(timestamp)
+    }
