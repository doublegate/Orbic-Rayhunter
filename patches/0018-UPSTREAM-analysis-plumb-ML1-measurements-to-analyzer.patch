+    fn report_measurement(
+        &mut self,
+        measurement: &Ml1Measurement,
+        timestamp: DateTime<FixedOffset>,
+    ) -> Vec<Option<Event>> {
+        let packet_str = self.packet_suffix();
+        let packet_num = self.packet_num;
+        self.analyzers
+            .iter_mut()
+            .map(|analyzer| {
+                let mut maybe_event =
+                    analyzer.report_measurement(measurement, packet_num, timestamp);
+                if let Some(ref mut event) = maybe_event {
+                    event.message.push_str(&packet_str);
+                }
+                maybe_event
+            })
+            .collect()
+    }
