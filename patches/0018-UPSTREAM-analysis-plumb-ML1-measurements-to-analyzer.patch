new file mode 100644
index 0000000..c2a497d
--- /dev/null
+++ b/lib/src/analysis/measurement.rs
@@ -0,0 +1,174 @@
+//! Physical-layer (ML1) measurement input for analyzers.
+//!
+//! RRC and NAS reach an analyzer as an [`InformationElement`]; physical-layer
+//! serving/neighbor cell measurements (PCI, EARFCN, RSRP) do not -- they are
+//! Qualcomm DIAG ML1 logs that the GSMTAP path does not model. This type is the
+//! analyzer-facing view of those measurements, decoupled from the on-wire deku
+//! structs, delivered through [`Analyzer::report_measurement`].
+//!
+//! It carries only cell-identity and signal-strength fields, never a subscriber
+//! identity, so it does not widen the identity surface analyzers already see.
+//!
+//! The measurement types are `#[non_exhaustive]`: ML1 carries more than is
+//! modelled here (RSRQ/RSSI, and RACH timing advance from other logs), so new
+//! variants and fields are expected and must not break a downstream `match`.
+//!
+//! [`InformationElement`]: super::information_element::InformationElement
+//! [`Analyzer::report_measurement`]: super::analyzer::Analyzer::report_measurement
+
+use crate::diag::diaglog::LogBody;
+
+/// The serving cell seen in an ML1 serving-cell measurement: its physical cell
+/// id, carrier, and measured reference-signal received power (dBm).
+#[derive(Debug, Clone, Copy, PartialEq)]
+#[non_exhaustive]
+pub struct Ml1ServingCell {
+    pub pci: u16,
+    pub earfcn: u32,
+    pub rsrp_dbm: f32,
+}
+
+/// One neighbor cell on the carrier of an ML1 neighbor measurement: its physical
+/// cell id and measured RSRP (dBm). The carrier EARFCN is on the parent
+/// [`Ml1Measurement::NeighborCells`].
+#[derive(Debug, Clone, Copy, PartialEq)]
+#[non_exhaustive]
+pub struct Ml1NeighborCell {
+    pub pci: u16,
+    pub rsrp_dbm: f32,
+}
+
+impl Ml1ServingCell {
+    /// Construct a serving-cell measurement. A constructor is provided because
+    /// the struct is `#[non_exhaustive]`, so callers in other crates (e.g. tests
+    /// of a custom [`Analyzer`]) cannot use a struct literal.
+    ///
+    /// [`Analyzer`]: super::analyzer::Analyzer
+    pub fn new(pci: u16, earfcn: u32, rsrp_dbm: f32) -> Self {
+        Self {
+            pci,
+            earfcn,
+            rsrp_dbm,
+        }
+    }
+}
+
+impl Ml1NeighborCell {
+    /// Construct a neighbor-cell measurement (see [`Ml1ServingCell::new`] for why
+    /// a constructor is provided).
+    pub fn new(pci: u16, rsrp_dbm: f32) -> Self {
+        Self { pci, rsrp_dbm }
+    }
+}
+
+/// Neighbor-cell measurements on one carrier (DIAG log `0xb180`). `earfcn` is
+/// kept on the report so it survives an empty `cells` list.
+#[derive(Debug, Clone, PartialEq)]
+#[non_exhaustive]
+pub struct Ml1NeighborCells {
+    pub earfcn: u32,
+    pub cells: Vec<Ml1NeighborCell>,
+}
+
+impl Ml1NeighborCells {
+    /// Construct a neighbor-cells report (see [`Ml1ServingCell::new`] for why a
+    /// constructor is provided).
+    pub fn new(earfcn: u32, cells: Vec<Ml1NeighborCell>) -> Self {
+        Self { earfcn, cells }
+    }
+}
+
+/// A decoded ML1 measurement report.
+#[derive(Debug, Clone, PartialEq)]
+#[non_exhaustive]
+pub enum Ml1Measurement {
+    /// Serving-cell measurement and evaluation (DIAG log `0xb17f`).
+    ServingCell(Ml1ServingCell),
+    /// Neighbor-cell measurements on one carrier (DIAG log `0xb180`).
+    NeighborCells(Ml1NeighborCells),
+}
+
+impl Ml1Measurement {
+    /// Build an [`Ml1Measurement`] from a decoded DIAG [`LogBody`], or `None`
+    /// when the log is not an ML1 serving/neighbor measurement.
+    pub fn from_log_body(body: &LogBody) -> Option<Self> {
+        match body {
+            LogBody::LteMl1ServingCellMeasurementAndEvaluation { data } => {
+                Some(Ml1Measurement::ServingCell(Ml1ServingCell {
+                    pci: data.get_pci(),
+                    earfcn: data.get_earfcn(),
+                    rsrp_dbm: data.get_meas_rsrp(),
+                }))
+            }
+            LogBody::LteMl1NeighborCellsMeasurements { data } => {
+                let cells = data
+                    .cells
+                    .iter()
+                    .map(|c| Ml1NeighborCell {
+                        pci: c.pci,
+                        rsrp_dbm: c.get_meas_rsrp(),
+                    })
+                    .collect();
+                Some(Ml1Measurement::NeighborCells(Ml1NeighborCells {
+                    earfcn: data.get_earfcn(),
+                    cells,
+                }))
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::test_util::unhexlify;
+    use deku::DekuReader;
+
+    // Serving-cell and neighbor-cell ML1 log bodies, as decoded by the diag
+    // ml1 parser tests (lib/src/diag/diaglog/ml1.rs). from_log_body must surface
+    // the same pci / earfcn / rsrp those tests assert.
+    const SERVING_V4: &str =
+        "040100009C18D60AECC44E00E2244E00FFFCE30FFED80A0047AD56021D310100A2624100";
+    const NEIGHBOR_V4: &str =
+        "040100009C1847008348E44DDEA44C00CAB4CC32B6D8420300000000FF773301FF77330122020100";
+
+    fn log_body(id: u16, payload_hex: &str) -> LogBody {
+        // LogBody is decoded with (log_type, hdr_len) as deku context; the ML1
+        // variants read a fixed-shape struct and do not use hdr_len.
+        let (_, mut reader) = unhexlify(payload_hex);
+        LogBody::from_reader_with_ctx(&mut reader, (id, 0)).expect("decodes")
+    }
+
+    #[test]
+    fn serving_cell_surfaces_pci_earfcn_rsrp() {
+        let m = Ml1Measurement::from_log_body(&log_body(0xb17f, SERVING_V4)).expect("serving");
+        assert_eq!(
+            m,
+            Ml1Measurement::ServingCell(Ml1ServingCell {
+                pci: 214,
+                earfcn: 6300,
+                rsrp_dbm: -101.25,
+            })
+        );
+    }
+
+    #[test]
+    fn neighbor_cells_surface_carrier_and_each_cell() {
+        let m = Ml1Measurement::from_log_body(&log_body(0xb180, NEIGHBOR_V4)).expect("neighbor");
+        assert_eq!(
+            m,
+            Ml1Measurement::NeighborCells(Ml1NeighborCells {
+                earfcn: 6300,
+                cells: vec![Ml1NeighborCell {
+                    pci: 131,
+                    rsrp_dbm: -102.125,
+                }],
+            })
+        );
+    }
+
+    // The non-ML1 (`_ => None`) path is exercised at the harness level by the
+    // measurement dispatch test in analyzer.rs, which feeds non-ML1 messages
+    // through analyze_qmdl_message.
+}
