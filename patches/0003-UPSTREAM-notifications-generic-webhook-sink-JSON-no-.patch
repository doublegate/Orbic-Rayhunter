+/// JSON payload for the generic webhook sink. Deliberately carries no
+/// subscriber identifiers (IMSI/IMEI/GUTI) -- only the event type, the
+/// human-readable message (the same text ntfy receives) and a timestamp.
+fn webhook_body(notification_type: &NotificationType, message: &str) -> String {
+    let type_str = match notification_type {
+        NotificationType::Warning => "Warning",
+        NotificationType::LowBattery => "LowBattery",
+        NotificationType::Update => "Update",
+    };
+    serde_json::json!({
+        "source": "rayhunter",
+        "type": type_str,
+        "message": message,
+        "timestamp": chrono::Utc::now().to_rfc3339(),
+    })
+    .to_string()
+}
