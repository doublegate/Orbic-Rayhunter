+/// Resolve a redacted secret value on a config write: an incoming `None` means
+/// "unchanged" (keep the stored value), an empty string clears it, and any other
+/// value replaces it.
+fn resolve_secret(incoming: Option<String>, stored: Option<&str>) -> Option<String> {
+    match incoming.as_deref() {
+        None => stored.map(str::to_string),
+        Some("") => None,
+        Some(_) => incoming,
+    }
+}
+
 /// Resolve the `ntfy_auth` secret to persist on a config write.
 ///
 /// `ntfy_auth` is redacted from `GET /api/config`, so a client that round-trips
@@ -206,6 +220,12 @@ pub async fn set_config(
         state.config.ntfy_auth.as_deref(),
         state.config.ntfy_url.as_deref(),
     );
+    // webhook_url is redacted from GET (it may embed a credential), so a
+    // round-trip that omits it must keep the stored value.
+    config.webhook_url = resolve_secret(
+        config.webhook_url.clone(),
+        state.config.webhook_url.as_deref(),
+    );
     let mut config_to_write = config.clone();
     config_to_write.wifi_ssid = None;
     config_to_write.wifi_password = None;
@@ -688,6 +708,7 @@ mod tests {
         let (_temp_dir, store_lock) = create_test_qmdl_store().await;
         let config = Config {
             ntfy_auth: Some("Bearer tk_secret".to_string()),
+            webhook_url: Some("https://hooks.example/T/B/secret".to_string()),
             ..Config::default()
         };
         let state = create_test_server_state_with_config(store_lock, config);
@@ -697,6 +718,23 @@ mod tests {
             returned.ntfy_auth, None,
             "ntfy_auth must be redacted from GET /api/config"
         );
+        assert_eq!(
+            returned.webhook_url, None,
+            "webhook_url may embed a credential and must be redacted"
+        );
+    }
+
+    #[test]
+    fn resolve_secret_preserves_clears_replaces() {
+        // None -> keep the stored value
+        assert_eq!(resolve_secret(None, Some("keep")), Some("keep".to_string()));
+        // empty string -> clear
+        assert_eq!(resolve_secret(Some(String::new()), Some("keep")), None);
+        // a value -> replace
+        assert_eq!(
+            resolve_secret(Some("new".to_string()), Some("old")),
+            Some("new".to_string())
+        );
     }
 
     #[test]
