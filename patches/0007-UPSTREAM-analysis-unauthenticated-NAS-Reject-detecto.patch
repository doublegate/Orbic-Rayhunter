     .expect("valid synthetic NAS information element")
 }
 
+/// Build a plain (unciphered) EMM message: the plain-NAS EMM header byte
+/// (security-header-type 0, protocol discriminator 7), the one-byte EMM message
+/// type, then the message `body`. Lets a test construct, e.g., an Attach Reject
+/// (`emm_message(68, &[cause])`) without hand-rolling the NAS header each time.
+pub(crate) fn emm_message(message_type: u8, body: &[u8]) -> InformationElement {
+    let mut payload = vec![0x07, message_type];
+    payload.extend_from_slice(body);
+    nas_plain(&payload)
+}
