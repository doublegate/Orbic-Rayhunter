+//! Detects an unauthenticated NAS Reject carrying an identity-forcing cause --
+//! the "IR" (Identity Reveal) blind spot the Devilray study (Oh et al., 2026)
+//! found in Rayhunter, which had keyed identity exposure only on an explicit
+//! Identity Request or IMSI paging.
+//!
+//! A false base station that cannot authenticate the UE (it has no access to the
+//! subscriber's home network keys) sends an `Attach Reject`, `Tracking Area
+//! Update Reject` or `Service Reject` with EMM cause #9 ("UE identity cannot be
+//! derived by the network") or #10 ("implicitly detached"). The UE then deletes
+//! its GUTI / marks the context invalid and re-attaches with its IMSI, exposing
+//! it. Such a reject is accepted without integrity protection before a security
+//! context exists (TS 24.301 4.4.4.2), so a reject seen BEFORE `Security Mode
+//! Complete` in an attach cycle is the strong signal; the same cause seen after
+//! a security context is established is far more likely a genuine network
+//! failure (e.g. an MME restart). See ref-docs/lte-imsi-catcher-detection.md
+//! section 3.2.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use pycrate_rs::nas::NASMessage;
+use pycrate_rs::nas::emm::EMMMessage;
+use pycrate_rs::nas::generated::emm::emm_attach_reject::EMMCauseEMMCause as AttachRejectCause;
+use pycrate_rs::nas::generated::emm::emm_service_reject::EMMCauseEMMCause as ServiceRejectCause;
+use pycrate_rs::nas::generated::emm::emm_tracking_area_update_reject::EMMCauseEMMCause as TauRejectCause;
+
+use telcom_parser::lte_rrc::{
+    DL_DCCH_MessageType, DL_DCCH_MessageType_c1, UL_CCCH_MessageType, UL_CCCH_MessageType_c1,
+};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+/// The EMM causes this detector treats as identity-forcing: #9 (the network
+/// claims it cannot identify the UE) and #10 (implicitly detached). Devilray
+/// found #9 the most reliable single-cell IMSI-catching cause across six COTS
+/// UEs from three baseband vendors. Other reject causes are intentionally NOT
+/// flagged here: #8 is a genuine unprovisioned-SIM reject (upstream already
+/// special-cases it), #11/#13/#15 fire on legitimate roaming/MVNO restrictions,
+/// #22 during real congestion, and #42 on genuine failures -- all high
+/// false-positive, and already surfaced informationally by the diagnostic
+/// analyzer. Keeping this detector to #9/#10 keeps it precise.
+macro_rules! is_identity_forcing {
+    ($cause:expr, $enum:ident) => {
+        matches!(
+            $cause,
+            $enum::UEIdentityCannotBeDerivedByTheNetwork | $enum::ImplicitlyDetached
+        )
+    };
+}
+
+#[derive(Default)]
+pub struct NasRejectAnalyzer {
+    /// Whether a security context was established (a `Security Mode Complete` was
+    /// seen) in the current RRC connection / attach cycle. It is reset at every
+    /// connection or procedure boundary (RRC connection setup or release -- which
+    /// also covers a cell change, since a new cell means a new connection -- and
+    /// each UE-initiated NAS request), so a stale "secured" from an earlier
+    /// connection can never suppress detection in a later one (fail closed, i.e.
+    /// toward flagging). A reject before it is the integrity-unprotected,
+    /// forgeable reject an FBS uses.
+    secured_this_cycle: bool,
+}
+
+impl NasRejectAnalyzer {
+    /// Emit the event for an identity-forcing reject, then end the cycle: after a
+    /// reject the UE re-attaches fresh, so a subsequent reject is unprotected
+    /// again until the next `Security Mode Complete`.
+    fn flag(&mut self, reject: &str) -> Option<Event> {
+        let event = if self.secured_this_cycle {
+            Event {
+                event_type: EventType::Low,
+                message: format!(
+                    "{reject} with an identity-forcing EMM cause (#9/#10) after a security context \
+                     was established -- most likely a genuine network failure (e.g. MME restart), \
+                     but noted because the cause forces IMSI re-exposure."
+                ),
+            }
+        } else {
+            Event {
+                event_type: EventType::High,
+                message: format!(
+                    "Unauthenticated {reject} with an identity-forcing EMM cause (#9 'UE identity \
+                     cannot be derived by the network' / #10 'implicitly detached'), received before \
+                     any security context. An integrity-unprotected reject that makes the UE delete \
+                     its GUTI and re-attach with its IMSI is a known false-base-station \
+                     identity-exposure technique (Devilray)."
+                ),
+            }
+        };
+        self.secured_this_cycle = false;
+        Some(event)
+    }
+}
+
+impl Analyzer for NasRejectAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Unauthenticated NAS Reject (identity-forcing)")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags an Attach/TAU/Service Reject carrying an identity-forcing EMM cause (#9 or #10) \
+             received before a security context is established -- the NAS-Reject IMSI-catching path \
+             (Devilray's identity-reveal blind spot) that the Identity-Request analyzer misses.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+
+        match lte.as_ref() {
+            // A new RRC connection (also a new cell) or its release ends the
+            // window in which an earlier Security Mode Complete applies.
+            LteInformationElement::UlCcch(rrc)
+                if matches!(
+                    rrc.message,
+                    UL_CCCH_MessageType::C1(
+                        UL_CCCH_MessageType_c1::RrcConnectionRequest(_)
+                            | UL_CCCH_MessageType_c1::RrcConnectionReestablishmentRequest(_)
+                    )
+                ) =>
+            {
+                self.secured_this_cycle = false;
+                None
+            }
+            LteInformationElement::DlDcch(rrc)
+                if matches!(
+                    rrc.message,
+                    DL_DCCH_MessageType::C1(DL_DCCH_MessageType_c1::RrcConnectionRelease(_))
+                ) =>
+            {
+                self.secured_this_cycle = false;
+                None
+            }
+
+            // A fresh UE-initiated NAS procedure: no security context yet.
+            LteInformationElement::NAS(NASMessage::EMMMessage(
+                EMMMessage::EMMAttachRequest(_)
+                | EMMMessage::EMMTrackingAreaUpdateRequest(_)
+                | EMMMessage::EMMExtServiceRequest(_),
+            )) => {
+                self.secured_this_cycle = false;
+                None
+            }
+            // Security context established for this cycle.
+            LteInformationElement::NAS(NASMessage::EMMMessage(
+                EMMMessage::EMMSecurityModeComplete(_),
+            )) => {
+                self.secured_this_cycle = true;
+                None
+            }
+            LteInformationElement::NAS(NASMessage::EMMMessage(EMMMessage::EMMAttachReject(r)))
+                if is_identity_forcing!(&r.emm_cause.inner, AttachRejectCause) =>
+            {
+                self.flag("Attach Reject")
+            }
+            LteInformationElement::NAS(NASMessage::EMMMessage(
+                EMMMessage::EMMTrackingAreaUpdateReject(r),
+            )) if is_identity_forcing!(&r.emm_cause.inner, TauRejectCause) => {
+                self.flag("Tracking Area Update Reject")
+            }
+            LteInformationElement::NAS(NASMessage::EMMMessage(EMMMessage::EMMServiceReject(r)))
+                if is_identity_forcing!(&r.emm_cause.inner, ServiceRejectCause) =>
+            {
+                self.flag("Service Reject")
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, emm_message, packet_time};
+
+    // EMM message type identifiers (TS 24.301 table 9.8.1).
+    const ATTACH_REJECT: u8 = 68;
+    const TAU_REJECT: u8 = 75;
+    const SERVICE_REJECT: u8 = 78;
+    const SECURITY_MODE_COMPLETE: u8 = 94;
+    // EMM cause values.
+    const CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED: u8 = 9;
+    const CAUSE_IMPLICITLY_DETACHED: u8 = 10;
+    const CAUSE_CONGESTION: u8 = 22;
+
+    #[test]
+    fn unauthenticated_identity_forcing_reject_is_high() {
+        let mut analyzer = NasRejectAnalyzer::default();
+        let events = collect_events(
+            &mut analyzer,
+            &[(
+                emm_message(ATTACH_REJECT, &[CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED]),
+                packet_time(0),
+            )],
+        );
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].0, 0);
+        assert_eq!(events[0].1.event_type, EventType::High);
+    }
+
+    #[test]
+    fn reject_after_security_mode_complete_is_low() {
+        let mut analyzer = NasRejectAnalyzer::default();
+        let events = collect_events(
+            &mut analyzer,
+            &[
+                (emm_message(SECURITY_MODE_COMPLETE, &[]), packet_time(0)),
+                (
+                    emm_message(ATTACH_REJECT, &[CAUSE_IMPLICITLY_DETACHED]),
+                    packet_time(1),
+                ),
+            ],
+        );
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].0, 1);
+        assert_eq!(events[0].1.event_type, EventType::Low);
+    }
+
+    #[test]
+    fn non_identity_forcing_cause_is_ignored() {
+        let mut analyzer = NasRejectAnalyzer::default();
+        let events = collect_events(
+            &mut analyzer,
+            &[(
+                emm_message(ATTACH_REJECT, &[CAUSE_CONGESTION]),
+                packet_time(0),
+            )],
+        );
+        assert!(events.is_empty());
+    }
+
+    #[test]
+    fn tau_and_service_rejects_are_covered() {
+        for message_type in [TAU_REJECT, SERVICE_REJECT] {
+            let mut analyzer = NasRejectAnalyzer::default();
+            let events = collect_events(
+                &mut analyzer,
+                &[(
+                    emm_message(message_type, &[CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED]),
+                    packet_time(0),
+                )],
+            );
+            assert_eq!(events.len(), 1, "message type {message_type}");
+            assert_eq!(events[0].1.event_type, EventType::High);
+        }
+    }
+
+    #[test]
+    fn a_reject_ends_the_cycle_so_the_next_is_unprotected_again() {
+        let mut analyzer = NasRejectAnalyzer::default();
+        let events = collect_events(
+            &mut analyzer,
+            &[
+                (emm_message(SECURITY_MODE_COMPLETE, &[]), packet_time(0)),
+                (
+                    emm_message(ATTACH_REJECT, &[CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED]),
+                    packet_time(1),
+                ),
+                (
+                    emm_message(ATTACH_REJECT, &[CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED]),
+                    packet_time(2),
+                ),
+            ],
+        );
+        assert_eq!(events.len(), 2);
+        // First reject: protected (Low). Second: fresh cycle, unprotected (High).
+        assert_eq!(events[0].1.event_type, EventType::Low);
+        assert_eq!(events[1].1.event_type, EventType::High);
+    }
+}
