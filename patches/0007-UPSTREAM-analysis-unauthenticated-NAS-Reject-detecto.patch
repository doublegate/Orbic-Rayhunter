--- /dev/null
+++ b/lib/src/analysis/nas_reject.rs
@@ -0,0 +1,185 @@
+//! Flags a NAS Reject (Attach, Tracking Area Update or Service Reject) carrying
+//! EMM cause #9 "UE identity cannot be derived by the network" or #10
+//! "implicitly detached". Cause #9 tells the UE to delete its GUTI and re-attach
+//! with its IMSI; a false base station that cannot authenticate the UE (it has
+//! no access to the subscriber's home keys) uses it to force IMSI exposure. The
+//! Devilray study (Oh et al., 2026) found #9 the most reliable single-cell
+//! IMSI-catching cause across six COTS UEs, and reported that detectors keying
+//! identity exposure only on an explicit Identity Request (as the Identity
+//! Request analyzer does) miss this NAS-Reject path. #10 is the same mechanism
+//! but fires far more often benignly, so it is reported at a lower severity.
+//!
+//! This analyzer keys on the reject cause alone. It deliberately does NOT claim
+//! the reject was integrity-unprotected, nor that an IMSI re-attach followed:
+//! the NAS security-header type is not preserved through the decrypted-NAS log
+//! this sees, and the EPS mobile identity in a following Attach Request is not
+//! decoded by the NAS parser (its generated identity struct is empty). So a
+//! genuine but uncommon #9/#10 -- an MME restart, a GUTI/MME-pool mismatch, or
+//! an idle-timer implicit detach -- is a false positive. It is therefore off by
+//! default and its severity is calibrated against live traffic before use.
+//! Confirming the unprotected-and-followed-by-IMSI case is future work that
+//! needs those two parser capabilities.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use pycrate_rs::nas::NASMessage;
+use pycrate_rs::nas::emm::EMMMessage;
+use pycrate_rs::nas::generated::emm::emm_attach_reject::EMMCauseEMMCause as AttachRejectCause;
+use pycrate_rs::nas::generated::emm::emm_service_reject::EMMCauseEMMCause as ServiceRejectCause;
+use pycrate_rs::nas::generated::emm::emm_tracking_area_update_reject::EMMCauseEMMCause as TauRejectCause;
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+/// Classify one reject's EMM cause into (severity, human-readable cause), or
+/// `None` for a cause this detector does not flag. #9 is the active
+/// identity-forcing cause (Medium); #10 is the same mechanism but much more
+/// often benign (Low). All other causes are left to the diagnostic analyzer.
+/// The three reject messages each have their own generated cause enum with
+/// identical variant names, so one macro serves all three.
+macro_rules! classify_cause {
+    ($cause:expr, $enum:ident) => {
+        match $cause {
+            $enum::UEIdentityCannotBeDerivedByTheNetwork => Some((
+                EventType::Medium,
+                "#9 (UE identity cannot be derived by the network)",
+            )),
+            $enum::ImplicitlyDetached => Some((EventType::Low, "#10 (implicitly detached)")),
+            _ => None,
+        }
+    };
+}
+
+pub struct NasRejectAnalyzer;
+
+impl NasRejectAnalyzer {
+    fn event(reject: &str, classification: Option<(EventType, &str)>) -> Option<Event> {
+        let (severity, cause) = classification?;
+        Some(Event {
+            event_type: severity,
+            message: format!(
+                "{reject} with EMM cause {cause}. This cause makes the UE delete its GUTI and \
+                 re-attach with its IMSI; a false base station that cannot authenticate the UE uses \
+                 it to force IMSI exposure (Devilray). Benign causes exist (MME restart, GUTI/pool \
+                 mismatch, idle-timer implicit detach), so corroborate before acting."
+            ),
+        })
+    }
+}
+
+impl Analyzer for NasRejectAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("NAS Reject with identity-forcing cause")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags an Attach/TAU/Service Reject carrying EMM cause #9 ('UE identity cannot be \
+             derived') or #10 ('implicitly detached') -- the NAS-Reject IMSI-catching path (the \
+             identity-reveal blind spot the Identity-Request analyzer misses). Keys on the cause \
+             alone; does not confirm the reject was unprotected or that an IMSI re-attach followed.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::NAS(NASMessage::EMMMessage(emm)) = lte.as_ref() else {
+            return None;
+        };
+        match emm {
+            EMMMessage::EMMAttachReject(r) => Self::event(
+                "Attach Reject",
+                classify_cause!(&r.emm_cause.inner, AttachRejectCause),
+            ),
+            EMMMessage::EMMTrackingAreaUpdateReject(r) => Self::event(
+                "Tracking Area Update Reject",
+                classify_cause!(&r.emm_cause.inner, TauRejectCause),
+            ),
+            EMMMessage::EMMServiceReject(r) => Self::event(
+                "Service Reject",
+                classify_cause!(&r.emm_cause.inner, ServiceRejectCause),
+            ),
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, emm_message, packet_time};
+
+    // EMM message type identifiers (TS 24.301 table 9.8.1).
+    const ATTACH_REJECT: u8 = 68;
+    const TAU_REJECT: u8 = 75;
+    const SERVICE_REJECT: u8 = 78;
+    // EMM cause values.
+    const CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED: u8 = 9;
+    const CAUSE_IMPLICITLY_DETACHED: u8 = 10;
+    const CAUSE_CONGESTION: u8 = 22;
+
+    fn one(message_type: u8, cause: u8) -> Vec<(usize, Event)> {
+        let mut analyzer = NasRejectAnalyzer;
+        collect_events(
+            &mut analyzer,
+            &[(emm_message(message_type, &[cause]), packet_time(0))],
+        )
+    }
+
+    #[test]
+    fn cause_9_is_medium() {
+        let events = one(ATTACH_REJECT, CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Medium);
+    }
+
+    #[test]
+    fn cause_10_is_low() {
+        let events = one(ATTACH_REJECT, CAUSE_IMPLICITLY_DETACHED);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Low);
+    }
+
+    #[test]
+    fn other_causes_are_ignored() {
+        assert!(one(ATTACH_REJECT, CAUSE_CONGESTION).is_empty());
+    }
+
+    #[test]
+    fn tau_and_service_rejects_are_covered() {
+        for message_type in [TAU_REJECT, SERVICE_REJECT] {
+            let events = one(message_type, CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED);
+            assert_eq!(events.len(), 1, "message type {message_type}");
+            assert_eq!(events[0].1.event_type, EventType::Medium);
+        }
+    }
+
+    #[test]
+    fn the_matched_cause_is_named_in_the_message() {
+        // Alerts must be actionable: #9 and #10 produce distinct messages.
+        assert!(
+            one(ATTACH_REJECT, CAUSE_UE_IDENTITY_CANNOT_BE_DERIVED)[0]
+                .1
+                .message
+                .contains("#9")
+        );
+        assert!(
+            one(ATTACH_REJECT, CAUSE_IMPLICITLY_DETACHED)[0]
+                .1
+                .message
+                .contains("#10")
+        );
+    }
+}
