+                    let header_arr;
+                    let headers: &[(&str, &str)] = if ntfy_headers {
+                        header_arr = ntfy_headers_for(notification_type);
+                        &header_arr
+                    } else {
+                        &[]
+                    };
+
                     match send_notification(
