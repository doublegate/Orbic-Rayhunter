-/// Sends a notification message to the specified URL.
+/// ntfy presentation headers (Title, Priority, Tags) derived from a
+/// notification type, so an ntfy client renders a titled, prioritized,
+/// tagged notification instead of a bare line. A generic webhook receiver
+/// ignores unknown headers, so this stays harmless off ntfy.
+/// See <https://docs.ntfy.sh/publish/>.
+fn ntfy_headers_for(notification_type: &NotificationType) -> [(&'static str, &'static str); 3] {
+    let (title, priority, tags) = match notification_type {
+        NotificationType::Warning => ("Rayhunter alert", "high", "rotating_light,warning"),
+        NotificationType::LowBattery => ("Rayhunter: low battery", "default", "battery,warning"),
+        NotificationType::Update => ("Rayhunter: update available", "low", "arrow_up"),
+    };
+    [("Title", title), ("Priority", priority), ("Tags", tags)]
+}
+
+/// Sends a notification message to the specified URL, applying each of
+/// `headers` as an HTTP header (empty for a plain POST, the historical
+/// behavior).
 pub async fn send_notification(
     http_client: &reqwest::Client,
     url: &str,
     message: String,
     timeout: u64,
+    headers: &[(&str, &str)],
 ) -> Result<(), NotificationError> {
-    let response = http_client
+    let mut request = http_client
         .post(url)
         .body(message)
-        .timeout(Duration::from_secs(timeout))
-        .send()
-        .await?;
+        .timeout(Duration::from_secs(timeout));
+    for (name, value) in headers {
+        request = request.header(*name, *value);
+    }
+    let response = request.send().await?;
 
     if response.status().is_success() {
         Ok(())
@@ -105,6 +124,7 @@ pub fn run_notification_worker(
