@@ -331,12 +372,62 @@ mod tests {
         assert_eq!(messages[0], "test warning message");
         drop(messages);
 
+        // With ntfy_headers disabled (default), the POST is plain: no ntfy
+        // presentation headers are added.
+        let headers = received_headers.lock().await;
