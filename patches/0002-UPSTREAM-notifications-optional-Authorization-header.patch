+
+        let Json(returned) = get_config(State(state)).await.unwrap();
+        assert_eq!(
+            returned.ntfy_auth, None,
+            "ntfy_auth must be redacted from GET /api/config"
+        );
+    }
+
+    #[test]
+    fn resolve_ntfy_auth_preserves_on_unchanged_url() {
+        let url = Some("https://ntfy.sh/t");
+        assert_eq!(
+            resolve_ntfy_auth(None, url, Some("Bearer x"), url),
+            Some("Bearer x".to_string())
+        );
+    }
+
+    #[test]
+    fn resolve_ntfy_auth_drops_secret_when_url_changes() {
+        // The config API is unauthenticated: a write that repoints ntfy_url must
+        // NOT carry the stored credential to the new endpoint.
+        assert_eq!(
+            resolve_ntfy_auth(
+                None,
+                Some("https://evil.example/t"),
+                Some("Bearer x"),
+                Some("https://ntfy.sh/t"),
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn resolve_ntfy_auth_empty_string_clears() {
+        let url = Some("https://ntfy.sh/t");
+        assert_eq!(
+            resolve_ntfy_auth(Some(String::new()), url, Some("Bearer x"), url),
+            None
+        );
+    }
+
+    #[test]
+    fn resolve_ntfy_auth_new_value_is_used() {
+        let url = Some("https://ntfy.sh/t");
+        assert_eq!(
+            resolve_ntfy_auth(Some("Bearer new".to_string()), url, Some("Bearer old"), url),
+            Some("Bearer new".to_string())
+        );
+    }
