     config.wifi_password = None;
+    config.ntfy_auth = None;
     Ok(Json(config))
 }
 
+/// Resolve the `ntfy_auth` secret to persist on a config write.
+///
+/// `ntfy_auth` is redacted from `GET /api/config`, so a client that round-trips
+/// the config sends `None` ("unchanged"). The config API is unauthenticated, so
+/// the stored secret is preserved ONLY when `ntfy_url` is also unchanged -- a
+/// write that repoints `ntfy_url` must not carry the stored credential to a new
+/// (possibly attacker-chosen) endpoint, so the credential is dropped and must be
+/// re-supplied. An explicit empty string clears it; any other value is used.
+fn resolve_ntfy_auth(
+    incoming_auth: Option<String>,
+    incoming_url: Option<&str>,
+    stored_auth: Option<&str>,
+    stored_url: Option<&str>,
+) -> Option<String> {
+    match incoming_auth.as_deref() {
+        None if incoming_url == stored_url => stored_auth.map(str::to_string),
+        None => None,
+        Some("") => None,
+        Some(_) => incoming_auth,
+    }
+}
