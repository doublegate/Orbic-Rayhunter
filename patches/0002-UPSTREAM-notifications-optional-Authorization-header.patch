+    #[tokio::test]
+    async fn test_get_config_redacts_ntfy_auth() {
+        let (_temp_dir, store_lock) = create_test_qmdl_store().await;
+        let config = Config {
+            ntfy_auth: Some("Bearer tk_secret".to_string()),
