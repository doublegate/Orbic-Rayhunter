+pub(crate) mod test_util;
 pub mod util;
diff --git a/lib/src/analysis/test_util.rs b/lib/src/analysis/test_util.rs
new file mode 100644
index 0000000..22c132e
--- /dev/null
+++ b/lib/src/analysis/test_util.rs
@@ -0,0 +1,96 @@
+//! Shared test helpers for analyzer unit tests -- the analyzer test harness
+//! (T-OR-051). Provides synthetic information-element builders and an
+//! event-collection helper so each analyzer's tests do not re-roll raw GSMTAP
+//! payloads or re-implement the run-and-collect loop. Compiled only under
+//! `cfg(test)`; the per-analyzer vector builders grow here as analyzers land.
+
+use chrono::{DateTime, FixedOffset, TimeDelta};
+
+use crate::analysis::analyzer::{Analyzer, Event};
+use crate::analysis::information_element::InformationElement;
+use crate::gsmtap::{GsmtapHeader, GsmtapMessage, GsmtapType, LteNasSubtype};
+
+/// A fixed, deterministic base time plus `seconds`, for sequencing packets
+/// within a test without depending on the wall clock.
+pub(crate) fn packet_time(seconds: i64) -> DateTime<FixedOffset> {
+    DateTime::parse_from_rfc3339("2025-01-01T00:00:00+00:00").unwrap() + TimeDelta::seconds(seconds)
+}
+
+/// Build a plain (unciphered) LTE NAS [`InformationElement`] from a raw NAS
+/// payload. The first octet carries the security-header-type and protocol
+/// discriminator, the second the message type, then the message body.
+pub(crate) fn nas_plain(payload: Vec<u8>) -> InformationElement {
+    InformationElement::try_from(&GsmtapMessage {
+        header: GsmtapHeader::new(GsmtapType::LteNas(LteNasSubtype::Plain)),
+        payload,
+    })
+    .expect("valid synthetic NAS information element")
+}
+
+/// Run `analyzer` over a sequence of `(information element, timestamp)` pairs
+/// and collect every [`Event`] it emits, so a test can golden-compare the
+/// result. Each element's index is passed as its `packet_num`.
+pub(crate) fn collect_events(
+    analyzer: &mut dyn Analyzer,
+    elements: &[(InformationElement, DateTime<FixedOffset>)],
+) -> Vec<Event> {
+    elements
+        .iter()
+        .enumerate()
+        .filter_map(|(packet_num, (ie, ts))| {
+            analyzer.analyze_information_element(ie, packet_num, *ts)
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::analyzer::EventType;
+    use std::borrow::Cow;
+
+    /// A trivial analyzer that emits one `Low` event per information element,
+    /// used to exercise [`collect_events`].
+    struct EveryElementAnalyzer;
+
+    impl Analyzer for EveryElementAnalyzer {
+        fn get_name(&self) -> Cow<'_, str> {
+            Cow::Borrowed("every-element (test)")
+        }
+        fn get_description(&self) -> Cow<'_, str> {
+            Cow::Borrowed("emits one event per information element")
+        }
+        fn analyze_information_element(
+            &mut self,
+            _ie: &InformationElement,
+            _packet_num: usize,
+            _timestamp: DateTime<FixedOffset>,
+        ) -> Option<Event> {
+            Some(Event {
+                event_type: EventType::Low,
+                message: "tick".to_string(),
+            })
+        }
+        fn get_version(&self) -> u32 {
+            0
+        }
+    }
+
+    #[test]
+    fn nas_plain_parses_as_an_information_element() {
+        // A minimal NAS payload must parse into an information element.
+        let _ie = nas_plain(vec![0x07, 0x55, 0x01]);
+    }
+
+    #[test]
+    fn collect_events_gathers_one_event_per_element() {
+        let mut analyzer = EveryElementAnalyzer;
+        let elements = vec![
+            (nas_plain(vec![0x07, 0x55, 0x01]), packet_time(0)),
+            (nas_plain(vec![0x07, 0x55, 0x01]), packet_time(1)),
+        ];
+        let events = collect_events(&mut analyzer, &elements);
+        assert_eq!(events.len(), 2);
+        assert!(events.iter().all(|e| e.event_type == EventType::Low));
+    }
+}
