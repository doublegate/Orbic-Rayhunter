+pub(crate) mod test_util;
 pub mod util;
diff --git a/lib/src/analysis/test_util.rs b/lib/src/analysis/test_util.rs
new file mode 100644
index 0000000..bb4efc2
--- /dev/null
+++ b/lib/src/analysis/test_util.rs
@@ -0,0 +1,113 @@
+//! Shared test helpers for analyzer unit tests: synthetic information-element
+//! builders and an event-collection helper so each analyzer's tests do not
+//! re-roll raw GSMTAP payloads or re-implement the run-and-collect loop.
+//! Compiled only under `cfg(test)`; the per-analyzer vector builders grow here
+//! as analyzers land.
+
+use chrono::{DateTime, FixedOffset, TimeDelta};
+
+use crate::analysis::analyzer::{Analyzer, Event};
+use crate::analysis::information_element::InformationElement;
+use crate::gsmtap::{GsmtapHeader, GsmtapMessage, GsmtapType, LteNasSubtype};
+
+/// A fixed, deterministic base time plus `seconds`, for sequencing packets
+/// within a test without depending on the wall clock.
+pub(crate) fn packet_time(seconds: i64) -> DateTime<FixedOffset> {
+    DateTime::parse_from_rfc3339("2025-01-01T00:00:00+00:00").unwrap() + TimeDelta::seconds(seconds)
+}
+
+/// Build a plain (unciphered) LTE NAS [`InformationElement`] from a raw NAS
+/// payload. The first octet carries the security-header-type and protocol
+/// discriminator, the second the message type, then the message body. Takes a
+/// borrowed slice so call sites avoid `vec![...]`; uplink/downlink direction and
+/// security-protected NAS variants are added here when a detector first needs
+/// them (the current detectors only need plain downlink NAS).
+pub(crate) fn nas_plain(payload: &[u8]) -> InformationElement {
+    InformationElement::try_from(&GsmtapMessage {
+        header: GsmtapHeader::new(GsmtapType::LteNas(LteNasSubtype::Plain)),
+        payload: payload.to_vec(),
+    })
+    .expect("valid synthetic NAS information element")
+}
+
+/// Run `analyzer` over a sequence of `(information element, timestamp)` pairs and
+/// collect every [`Event`] it emits, each paired with the 0-based index of the
+/// element that produced it. Returning the index (rather than a bare
+/// `Vec<Event>`) lets a test assert WHICH packet fired, which matters for a
+/// stateful multi-packet analyzer that must only fire on a specific element in a
+/// sequence. The index is also passed to the analyzer as its `packet_num`.
+pub(crate) fn collect_events(
+    analyzer: &mut dyn Analyzer,
+    elements: &[(InformationElement, DateTime<FixedOffset>)],
+) -> Vec<(usize, Event)> {
+    elements
+        .iter()
+        .enumerate()
+        .filter_map(|(packet_num, (ie, ts))| {
+            analyzer
+                .analyze_information_element(ie, packet_num, *ts)
+                .map(|event| (packet_num, event))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::analyzer::EventType;
+    use crate::analysis::information_element::LteInformationElement;
+    use std::borrow::Cow;
+
+    /// A trivial analyzer that emits one `Low` event per information element,
+    /// used to exercise [`collect_events`].
+    struct EveryElementAnalyzer;
+
+    impl Analyzer for EveryElementAnalyzer {
+        fn get_name(&self) -> Cow<'_, str> {
+            Cow::Borrowed("every-element (test)")
+        }
+        fn get_description(&self) -> Cow<'_, str> {
+            Cow::Borrowed("emits one event per information element")
+        }
+        fn analyze_information_element(
+            &mut self,
+            _ie: &InformationElement,
+            _packet_num: usize,
+            _timestamp: DateTime<FixedOffset>,
+        ) -> Option<Event> {
+            Some(Event {
+                event_type: EventType::Low,
+                message: "tick".to_string(),
+            })
+        }
+        fn get_version(&self) -> u32 {
+            0
+        }
+    }
+
+    #[test]
+    fn nas_plain_builds_an_lte_nas_information_element() {
+        // A minimal NAS payload parses specifically into an LTE NAS element
+        // (not just "some information element").
+        let ie = nas_plain(&[0x07, 0x55, 0x01]);
+        assert!(
+            matches!(&ie, InformationElement::LTE(lte) if matches!(lte.as_ref(), LteInformationElement::NAS(_))),
+            "nas_plain must produce an LTE NAS information element"
+        );
+    }
+
+    #[test]
+    fn collect_events_pairs_each_event_with_its_packet_index() {
+        let mut analyzer = EveryElementAnalyzer;
+        let elements = vec![
+            (nas_plain(&[0x07, 0x55, 0x01]), packet_time(0)),
+            (nas_plain(&[0x07, 0x55, 0x01]), packet_time(1)),
+        ];
+        let events = collect_events(&mut analyzer, &elements);
+        // One event per element, each tagged with the index that produced it.
+        assert_eq!(events.len(), 2);
+        assert_eq!(events[0].0, 0);
+        assert_eq!(events[1].0, 1);
+        assert!(events.iter().all(|(_, e)| e.event_type == EventType::Low));
+    }
+}
