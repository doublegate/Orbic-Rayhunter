 use crate::analysis::information_element::InformationElement;
 use crate::gsmtap::{GsmtapHeader, GsmtapMessage, GsmtapType, LteNasSubtype, LteRrcSubtype};
 
+/// Decode a hex string into bytes, for synthetic PDU test vectors. Asserts an
+/// even length so a mistyped vector fails clearly rather than panicking in the
+/// slice. Shared by every analyzer's tests.
+pub(crate) fn hex(s: &str) -> Vec<u8> {
+    assert_eq!(s.len() % 2, 0, "odd-length hex vector");
+    (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+        .collect()
+}
