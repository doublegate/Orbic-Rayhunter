diff --git a/lib/src/analysis/imsi_paging.rs b/lib/src/analysis/imsi_paging.rs
new file mode 100644
index 0000000..6f72b70
--- /dev/null
+++ b/lib/src/analysis/imsi_paging.rs
@@ -0,0 +1,160 @@
+//! Flags a network paging a UE by its permanent IMSI on PCCH.
+//!
+//! A network normally pages a UE by a temporary identity (an S-TMSI derived
+//! from the GUTI it assigned at attach). Paging by the permanent IMSI is a
+//! known IMSI-catcher technique: the operator of a false base station that has
+//! learned a target's IMSI pages that IMSI to make the target's UE respond,
+//! confirming the subscriber's presence in the area without completing an
+//! attach. A legitimate network has the subscriber's temporary identity and has
+//! no reason to page by IMSI, so an IMSI paging record is a strong, low-false-
+//! positive signal (High).
+//!
+//! This analyzer flags *any* IMSI paging record. Narrowing it to "paged by
+//! **our** IMSI" -- comparing the paged identity to the device's own IMSI held
+//! only as a salted in-memory hash -- needs the device IMSI read over AT, which
+//! is tracked separately (T-OR-116); it does not change that paging by IMSI at
+//! all is anomalous.
+//!
+//! Privacy: the analyzer reads only the identity *type* (IMSI vs. a temporary
+//! identity), never the paged digits, so no IMSI reaches the event, per the
+//! in-memory identity contract in docs/ANALYZERS.md.
+//!
+//! Stateless; off by default pending per-network calibration.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use telcom_parser::lte_rrc::{PCCH_MessageType, PCCH_MessageType_c1, PagingUE_Identity};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct ImsiPagingAnalyzer;
+
+impl Analyzer for ImsiPagingAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("IMSI paging")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags a PCCH paging record that addresses a UE by its permanent IMSI rather than a \
+             temporary identity (S-TMSI). A false base station pages a known IMSI to confirm a \
+             target's presence; the main benign cause is MME failure/restoration. Reads only the \
+             identity type, never the paged digits. Reported Medium because it cannot yet tell \
+             whether the paged IMSI is this device's (T-OR-116). Off by default pending calibration.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::PCCH(pcch) = lte.as_ref() else {
+            return None;
+        };
+        let PCCH_MessageType::C1(PCCH_MessageType_c1::Paging(paging)) = &pcch.message else {
+            return None;
+        };
+        let records = paging.paging_record_list.as_ref()?;
+        let paged_by_imsi = records
+            .0
+            .iter()
+            .any(|r| matches!(r.ue_identity, PagingUE_Identity::Imsi(_)));
+        paged_by_imsi.then(|| Event {
+            event_type: EventType::Medium,
+            message: "A UE was paged by its permanent IMSI on PCCH -- normal paging uses a \
+                      temporary identity (S-TMSI); a benign cause is MME restoration"
+                .to_string(),
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, lte_rrc, packet_time};
+    use crate::gsmtap::LteRrcSubtype;
+
+    fn hex(s: &str) -> Vec<u8> {
+        assert_eq!(s.len() % 2, 0, "odd-length hex vector");
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    // PCCH Paging PDUs encoded with the reference Python pycrate (TS 36.331
+    // ASN.1) and decoded here through telcom_parser. All synthetic.
+    // One paging record, ue-Identity = imsi (test IMSI 001010123456789).
+    const PAGING_IMSI: &str = "40190010101234567890";
+    // One paging record, ue-Identity = s-TMSI (the normal case).
+    const PAGING_STMSI: &str = "40001123456780";
+    // A Paging message with no paging records (e.g. a bare SI-modification page).
+    const PAGING_EMPTY: &str = "00";
+    // Two records: an S-TMSI then an IMSI (the IMSI is not the first record).
+    const PAGING_STMSI_THEN_IMSI: &str = "40801123456781900101012345678900";
+
+    fn run(v: &str) -> Vec<(usize, Event)> {
+        let mut a = ImsiPagingAnalyzer;
+        collect_events(
+            &mut a,
+            &[(lte_rrc(LteRrcSubtype::PCCH, &hex(v)), packet_time(0))],
+        )
+    }
+
+    #[test]
+    fn paging_by_imsi_is_medium() {
+        let events = run(PAGING_IMSI);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Medium);
+        assert!(events[0].1.message.contains("IMSI"));
+        // never the digits
+        assert!(!events[0].1.message.contains("001010123456789"));
+    }
+
+    #[test]
+    fn imsi_record_after_an_s_tmsi_record_still_fires() {
+        // Exercises `.any(..)` beyond the first record.
+        let events = run(PAGING_STMSI_THEN_IMSI);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Medium);
+    }
+
+    #[test]
+    fn paging_by_s_tmsi_is_ignored() {
+        assert!(run(PAGING_STMSI).is_empty());
+    }
+
+    #[test]
+    fn paging_with_no_records_is_ignored() {
+        assert!(run(PAGING_EMPTY).is_empty());
+    }
+
+    #[test]
+    fn non_pcch_lte_message_is_ignored() {
+        // A BCCH SystemInformation is an LTE IE but not PCCH: exercises the
+        // inner LteInformationElement::PCCH guard (the outer LTE check passes).
+        use crate::analysis::test_util::bcch_dl_sch;
+        let sysinfo = hex(
+            "00025b30542fdb28c44605a28158000c032073bd156124000c026dd096af81c6892003c00310030000",
+        );
+        let mut a = ImsiPagingAnalyzer;
+        assert!(collect_events(&mut a, &[(bcch_dl_sch(&sysinfo), packet_time(0))]).is_empty());
+    }
+
+    #[test]
+    fn non_lte_information_element_is_ignored() {
+        let mut a = ImsiPagingAnalyzer;
+        assert!(collect_events(&mut a, &[(InformationElement::GSM, packet_time(0))]).is_empty());
+    }
+}
