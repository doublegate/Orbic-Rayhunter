+/// Gotify message payload (title, message, priority 0-10) for a notification
+/// type. See <https://gotify.net/api-docs#/message/createMessage>.
+fn gotify_body(notification_type: &NotificationType, message: &str) -> String {
+    let (title, priority) = match notification_type {
+        NotificationType::Warning => ("Rayhunter alert", 8),
+        NotificationType::LowBattery => ("Rayhunter: low battery", 5),
+        NotificationType::Update => ("Rayhunter: update available", 2),
+    };
+    serde_json::json!({ "title": title, "message": message, "priority": priority }).to_string()
+}
