+    #[tokio::test]
+    async fn test_notification_worker_sends_gotify() {
+        let (received_messages, received_headers, url) = setup_test_server().await;
+
+        let task_tracker = TaskTracker::new();
+        let notification_service = NotificationService::new(None, None, Some(url));
+        let notification_sender = notification_service.new_handler();
+
+        run_notification_worker(
+            &task_tracker,
+            notification_service,
+            vec![NotificationType::Warning],
+            false,
+            None,
+            Some("gotify-app-token".to_string()),
+        );
+
+        notification_sender
+            .send(Notification::new(
+                NotificationType::Warning,
+                "gotify msg".to_string(),
+                None,
+            ))
+            .await
+            .unwrap();
+
+        tokio::time::sleep(Duration::from_secs(3)).await;
+
+        // Gotify JSON {title, message, priority} delivered to /message.
+        let messages = received_messages.lock().await;
+        assert_eq!(messages.len(), 1);
+        let v: serde_json::Value = serde_json::from_str(&messages[0]).unwrap();
+        assert_eq!(v["title"], "Rayhunter alert");
+        assert_eq!(v["message"], "gotify msg");
+        assert_eq!(v["priority"], 8);
+        drop(messages);
+
+        let headers = received_headers.lock().await;
+        assert_eq!(headers[0].get("x-gotify-key").unwrap(), "gotify-app-token");
+        drop(headers);
+
+        cleanup_worker(notification_sender, task_tracker).await;
+    }
