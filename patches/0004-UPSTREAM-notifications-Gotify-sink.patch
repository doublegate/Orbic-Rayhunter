-fn resolve_ntfy_auth(
-    incoming_auth: Option<String>,
+fn resolve_endpoint_secret(
+    incoming_secret: Option<String>,
     incoming_url: Option<&str>,
-    stored_auth: Option<&str>,
+    stored_secret: Option<&str>,
     stored_url: Option<&str>,
 ) -> Option<String> {
-    match incoming_auth.as_deref() {
-        None if incoming_url == stored_url => stored_auth.map(str::to_string),
+    match incoming_secret.as_deref() {
+        None if incoming_url == stored_url => stored_secret.map(str::to_string),
         None => None,
         Some("") => None,
-        Some(_) => incoming_auth,
+        Some(_) => incoming_secret,
     }
 }
 
