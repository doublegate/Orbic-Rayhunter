From 771b32f2de3a2a02eec735f7492bf00c4f02963e Mon Sep 17 00:00:00 2001
From: DoubleGate <parobek@gmail.com>
Date: Fri, 27 Nov 2026 21:42:04 -0500
Subject: [PATCH] [UPSTREAM] deps: decode mobile identities via pycrate-rs
 (T-OR-110)

pycrate-rs at the pinned upstream commit parses the EPS mobile identity
(TS 24.301 9.9.3.12) and mobile identity (TS 24.008 10.5.1.4) IEs into
empty structs, discarding the value octets, so no analyzer can tell an IMSI
or IMEI from a GUTI/TMSI in an Identity Response, Attach Request, Security
Mode Complete or TAU message. That blocks the identity-disclosure detector
(T-OR-054).

Point lib/ at a pycrate-rs fork commit that adds the decoding
(doublegate/pycrate-rs@77b1cc8236a6d4a7c0de571c9e550a58e13cb00a, tag
orbic-rayhunter-pin-t-or-110): EpsMobileIdentity and MobileIdentity expose
identity_type(), digit_string(), guti(), tmsi() and is_well_formed(), and
never emit identity values from Debug/Serialize. Cargo.lock changes only the
pycrate-rs source line (verified with --locked). The pin is temporary: the
upstream submission is this same patch pointing at EFForg/pycrate-rs once
the parser change merges there.

Fork audit against the previous pin 9e72e40: two commits, EFF's own README
commit 9ca5f54 and the mobile-identity change. No build.rs, proc-macro,
unsafe, network/filesystem/process use, or new runtime dependency (only a
dev-only serde_json).

Add a harness test that an Identity Response carrying a synthetic IMSI
decodes through the live InformationElement path with its type and digits,
and that neither Debug nor Serialize output carries the digits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: DoubleGate <parobek@gmail.com>
---
 Cargo.lock                    |  2 +-
 lib/Cargo.toml                |  4 +++-
 lib/src/analysis/test_util.rs | 45 +++++++++++++++++++++++++++++++++++
 3 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index c20d9bb..e5954b7 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -4445,7 +4445,7 @@ dependencies = [
 [[package]]
 name = "pycrate-rs"
 version = "0.1.0"
-source = "git+https://github.com/EFForg/pycrate-rs#9e72e40bee9c3c09205ad871cf681628b443de7c"
+source = "git+https://github.com/doublegate/pycrate-rs?rev=77b1cc8236a6d4a7c0de571c9e550a58e13cb00a#77b1cc8236a6d4a7c0de571c9e550a58e13cb00a"
 dependencies = [
  "clap",
  "deku 0.18.1",
diff --git a/lib/Cargo.toml b/lib/Cargo.toml
index 0466724..4ef8a94 100644
--- a/lib/Cargo.toml
+++ b/lib/Cargo.toml
@@ -21,7 +21,9 @@ log = "0.4.20"
 env_logger = { version = "0.11", default-features = false }
 nix = { version = "0.29.0", features = ["feature"] }
 pcap-file-tokio = "0.1.0"
-pycrate-rs = { git = "https://github.com/EFForg/pycrate-rs" }
+# Fork carrying EPS mobile identity / mobile identity decoding (T-OR-110) until it
+# lands in EFForg/pycrate-rs; pinned to an exact commit.
+pycrate-rs = { git = "https://github.com/doublegate/pycrate-rs", rev = "77b1cc8236a6d4a7c0de571c9e550a58e13cb00a" }
 thiserror = "1.0.50"
 telcom-parser = { path = "../telcom-parser" }
 tokio = { version = "1.44.2", default-features = false, features = ["time", "rt", "macros", "fs", "io-util"] }
diff --git a/lib/src/analysis/test_util.rs b/lib/src/analysis/test_util.rs
index 1914284..24dbf23 100644
--- a/lib/src/analysis/test_util.rs
+++ b/lib/src/analysis/test_util.rs
@@ -200,6 +200,51 @@ mod tests {
         );
     }
 
+    #[test]
+    fn emm_identity_response_exposes_the_decoded_identity() {
+        // T-OR-110: an Identity Response's mobile identity must survive decoding
+        // through the live InformationElement path, so identity analyzers
+        // (T-OR-054) can tell an IMSI from a temporary identity. Synthetic test
+        // IMSI 001010123456789 (test PLMN 001/01), never a real subscriber.
+        use pycrate_rs::nas::NASMessage;
+        use pycrate_rs::nas::emm::EMMMessage;
+        use pycrate_rs::nas::mobile_identity::IdentityType;
+        let ie = emm_message(0x56, &hex_literal_decode("080910101032547698"));
+        let InformationElement::LTE(lte) = &ie else {
+            panic!("expected an LTE information element");
+        };
+        let LteInformationElement::NAS(NASMessage::EMMMessage(EMMMessage::EMMIdentityResponse(
+            resp,
+        ))) = lte.as_ref()
+        else {
+            panic!("expected an EMM Identity Response");
+        };
+        assert_eq!(resp.id.inner.identity_type(), IdentityType::Imsi);
+        assert!(resp.id.inner.is_well_formed());
+        assert_eq!(
+            resp.id.inner.digit_string().as_deref(),
+            Some("001010123456789")
+        );
+        // and neither Debug (of the identity or the whole information element)
+        // nor Serialize (of the identity or the whole decoded NAS message) carries
+        // the digits, while the identity type is still reported.
+        for rendered in [
+            format!("{:?}", resp.id.inner),
+            format!("{ie:?}"),
+            serde_json::to_string(&resp.id.inner).expect("serialize identity"),
+            serde_json::to_string(resp).expect("serialize message"),
+        ] {
+            assert!(
+                !rendered.contains("123456789"),
+                "identity digits leaked: {rendered}"
+            );
+            assert!(
+                rendered.contains("Imsi"),
+                "identity type missing: {rendered}"
+            );
+        }
+    }
+
     #[test]
     fn collect_events_pairs_each_event_with_its_packet_index() {
         let mut analyzer = EveryElementAnalyzer;
