+    // ---- T-OR-110: mobile identities decoded through the live path ----
+    //
+    // Identity analyzers (T-OR-054) need to tell an IMSI/IMEI from a temporary
+    // identity, so the decoded IE must survive the GSMTAP -> InformationElement
+    // path for both IE flavours: `ID` (TS 24.008, carried here by an Identity
+    // Response) and `EPSID` (TS 24.301, carried by a TAU Request's old GUTI).
+    // All identities below are synthetic: test PLMN 001/01, the published example
+    // IMEI 490154203237518, and made-up IMEISV/TMSI/GUTI values.
+
+    /// Decode a plain EMM message through `InformationElement::try_from`,
+    /// returning the decode error instead of panicking.
+    fn decode_emm(message_type: u8, body: &[u8]) -> Result<pycrate_rs::nas::NASMessage, String> {
+        let mut payload = vec![0x07, message_type];
+        payload.extend_from_slice(body);
+        let ie = InformationElement::try_from(&GsmtapMessage {
+            header: GsmtapHeader::new(GsmtapType::LteNas(LteNasSubtype::Plain)),
+            payload,
+        })
+        .map_err(|e| format!("{e:?}"))?;
+        match ie {
+            InformationElement::LTE(lte) => match *lte {
+                LteInformationElement::NAS(msg) => Ok(msg),
+                _ => Err("not a NAS element".to_owned()),
+            },
+            _ => Err("not an LTE element".to_owned()),
+        }
+    }
+
+    /// An Identity Response (0x56) whose mobile identity (`ID`) is `value`.
+    fn identity_response_id(
+        value: &[u8],
+    ) -> Result<(pycrate_rs::nas::mobile_identity::MobileIdentity, String), String> {
+        use pycrate_rs::nas::{NASMessage, emm::EMMMessage};
+        let mut body = vec![value.len() as u8];
+        body.extend_from_slice(value);
+        match decode_emm(0x56, &body)? {
+            NASMessage::EMMMessage(EMMMessage::EMMIdentityResponse(r)) => {
+                let json = serde_json::to_string(&r).map_err(|e| e.to_string())?;
+                let out = format!("{json} {r:?}");
+                Ok((r.id.inner, out))
+            }
+            other => Err(format!("not an Identity Response: {other:?}")),
+        }
+    }
+
+    /// A TAU Request (0x48) whose old GUTI (`EPSID`) is `value`.
+    fn tau_request_epsid(
+        value: &[u8],
+    ) -> Result<(pycrate_rs::nas::mobile_identity::EpsMobileIdentity, String), String> {
+        use pycrate_rs::nas::{NASMessage, emm::EMMMessage};
+        // 0x61: EPS update type + NAS KSI half-octets, then the LV old GUTI.
+        let mut body = vec![0x61, value.len() as u8];
+        body.extend_from_slice(value);
+        match decode_emm(0x48, &body)? {
+            NASMessage::EMMMessage(EMMMessage::EMMTrackingAreaUpdateRequest(r)) => {
+                let json = serde_json::to_string(&r).map_err(|e| e.to_string())?;
+                let out = format!("{json} {r:?}");
+                Ok((r.old_guti.inner, out))
+            }
+            other => Err(format!("not a TAU Request: {other:?}")),
+        }
+    }
+
+    /// Everything that reaches logs, reports or JSON for one identity: its own
+    /// Debug and Serialize plus those of the whole decoded message.
+    fn rendered<T: std::fmt::Debug + serde::Serialize>(id: &T, message: &str) -> String {
+        format!("{id:?} {} {message}", serde_json::to_string(id).unwrap())
+    }
+
+    fn assert_not_leaked(rendered: &str, forbidden: &[&str]) {
+        for f in forbidden {
+            assert!(
+                !rendered.contains(f),
+                "identity value {f:?} leaked: {rendered}"
+            );
+        }
+    }
+
+    #[test]
+    fn each_identity_type_decodes_on_both_carriers_without_leaking() {
+        use pycrate_rs::nas::mobile_identity::IdentityType as T;
+        // (hex value, expected type, expected digits, values that must never render)
+        let id_cases: &[(&str, T, Option<&str>, &[&str])] = &[
+            (
+                "0910101032547698",
+                T::Imsi,
+                Some("001010123456789"),
+                &[
+                    "001010123456789",
+                    "123456789",
+                    "00101",
+                    "0910101032547698",
+                    "32547698",
+                    "[9, 16",
+                ],
+            ),
+            (
+                "4a09512430325781",
+                T::Imei,
+                Some("490154203237518"),
+                &["490154203237518", "4a0951", "[74, 9"],
+            ),
+            (
+                "3355140216325406f1",
+                T::Imeisv,
+                Some("3554120612345601"),
+                &["3554120612345601", "12345601", "335514"],
+            ),
+            (
+                "f4deadbeef",
+                T::Tmsi,
+                None,
+                &["deadbeef", "DEADBEEF", "3735928559"],
+            ),
+        ];
+        for (hex, ty, digits, forbidden) in id_cases {
+            let (id, msg) = identity_response_id(&hex_literal_decode(hex)).expect(hex);
+            assert_eq!(id.identity_type(), *ty, "{hex}");
+            assert!(id.is_well_formed(), "{hex}");
+            assert_eq!(id.digit_string().as_deref(), *digits, "{hex}");
+            let out = rendered(&id, &msg);
+            assert_not_leaked(&out, forbidden);
+            assert!(out.contains(&format!("{ty:?}")), "type missing: {out}");
+        }
+        // EPSID: TS 24.301 numbers type 011 as IMEI (TS 24.008 calls it IMEISV).
+        let eps_cases: &[(&str, T, Option<&str>, &[&str])] = &[
+            (
+                "0910101032547698",
+                T::Imsi,
+                Some("001010123456789"),
+                &["001010123456789", "123456789", "00101", "32547698"],
+            ),
+            (
+                "4b09512430325781",
+                T::Imei,
+                Some("490154203237518"),
+                &["490154203237518", "4b0951"],
+            ),
+            (
+                "f600f11080010112345678",
+                T::Guti,
+                None,
+                &["12345678", "305419896"],
+            ),
+        ];
+        for (hex, ty, digits, forbidden) in eps_cases {
+            let (id, msg) = tau_request_epsid(&hex_literal_decode(hex)).expect(hex);
+            assert_eq!(id.identity_type(), *ty, "{hex}");
+            assert!(id.is_well_formed(), "{hex}");
+            assert_eq!(id.digit_string().as_deref(), *digits, "{hex}");
+            assert_not_leaked(&rendered(&id, &msg), forbidden);
+        }
+        // the GUTI's network part is exposed (it names the network, not the UE)
+        let (guti, _) = tau_request_epsid(&hex_literal_decode("f600f11080010112345678")).unwrap();
+        let g = guti.guti().expect("GUTI");
+        assert_eq!(
+            (g.mcc(), g.mnc(), g.mme_group_id(), g.mme_code()),
+            ("001", "01", 0x8001, 0x01)
+        );
+        assert_eq!(g.m_tmsi(), 0x1234_5678);
+    }
+
+    #[test]
+    fn malformed_mobile_identities_still_decode_the_message() {
+        // Before T-OR-110 these IEs were empty structs that could not fail; the
+        // decoder must keep that property so a malformed identity never drops
+        // the message (which would blind every analyzer that reads it).
+        let malformed: &[&[u8]] = &[
+            &[],                 // length 0
+            &[0x07],             // reserved type in both tables
+            &[0x09, 0x1a],       // IMSI with a non-BCD digit
+            &[0x01],             // IMSI, even digit count but no second octet
+            &[0x01, 0x10, 0x01], // IMSI, even count with no 1111 filler
+            &[0xf6, 0x13, 0x01], // truncated GUTI
+            &[0xf4, 0xde, 0xad], // truncated TMSI
+        ];
+        for v in malformed {
+            let (id, _) = identity_response_id(v).unwrap_or_else(|e| panic!("ID {v:02x?}: {e}"));
+            let (eps, _) = tau_request_epsid(v).unwrap_or_else(|e| panic!("EPSID {v:02x?}: {e}"));
+            assert!(!id.is_well_formed(), "ID {v:02x?} accepted");
+            assert!(!eps.is_well_formed(), "EPSID {v:02x?} accepted");
+        }
+    }
+
+    #[test]
+    fn no_mobile_identity_value_panics_or_loses_the_message() {
+        // Exhaustive over the identity-type octet and every length up to 12
+        // (GUTI is 11), with varying payload bytes: decoding must neither panic
+        // nor fail the surrounding message.
+        for first in 0..=255u8 {
+            for len in 0..=12usize {
+                let v: Vec<u8> = (0..len)
+                    .map(|i| {
+                        if i == 0 {
+                            first
+                        } else {
+                            (i as u8).wrapping_mul(37) ^ first
+                        }
+                    })
+                    .collect();
+                identity_response_id(&v).unwrap_or_else(|e| panic!("ID {v:02x?}: {e}"));
+                tau_request_epsid(&v).unwrap_or_else(|e| panic!("EPSID {v:02x?}: {e}"));
+            }
+        }
+    }
+
     #[test]
     fn collect_events_pairs_each_event_with_its_packet_index() {
         let mut analyzer = EveryElementAnalyzer;
