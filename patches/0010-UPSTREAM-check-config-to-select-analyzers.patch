From 5204f7a6b779d379c85fc829114b46c81ec2449b Mon Sep 17 00:00:00 2001
From: DoubleGate <parobek@gmail.com>
Date: Thu, 26 Nov 2026 13:03:13 -0500
Subject: [PATCH] [UPSTREAM] check: --config to select analyzers for offline
 re-analysis

rayhunter-check hardcoded AnalyzerConfig::default(), so offline re-analysis of a
capture ran only the default-on analyzers and could not exercise any detector
that is off by default (the v1.2.0 NAS detectors, or a future one). Add a
--config <file> flag that loads the [analyzers] table from a rayhunter config
(unknown keys ignored, so a full device config.toml works), threaded into the
pcap and qmdl analysis paths and the report metadata; without it the defaults
are unchanged.

This makes false-positive calibration reproducible from committed code: a
capture can be re-scored with the detectors enabled (T-OR-113), which the daemon
already runs on-device. Adds a toml dependency to the check crate (already in the
workspace lockfile via the daemon).
---
 Cargo.lock        |  1 +
 check/Cargo.toml  |  1 +
 check/src/main.rs | 57 +++++++++++++++++++++++++++++++++++++++++------
 3 files changed, 52 insertions(+), 7 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 627b379..c20d9bb 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -4655,6 +4655,7 @@ dependencies = [
  "serde",
  "serde_json",
  "tokio",
+ "toml 0.8.22",
  "walkdir",
 ]
 
diff --git a/check/Cargo.toml b/check/Cargo.toml
index 903b856..f111065 100644
--- a/check/Cargo.toml
+++ b/check/Cargo.toml
@@ -14,3 +14,4 @@ clap = { version = "4.5.2", features = ["derive"] }
 walkdir = "2.5.0"
 serde = "1.0.229"
 serde_json = "1.0.151"
+toml = "0.8.8"
diff --git a/check/src/main.rs b/check/src/main.rs
index cee1933..342da38 100644
--- a/check/src/main.rs
+++ b/check/src/main.rs
@@ -33,6 +33,14 @@ struct Args {
     #[arg(short = 'j', long, help = "Output report to a JSON file")]
     json: Option<PathBuf>,
 
+    #[arg(
+        long,
+        help = "Path to a rayhunter config file whose [analyzers] table selects which \
+                analyzers run (default: the built-in defaults). Use this to re-analyze \
+                captures with detectors that are off by default."
+    )]
+    config: Option<PathBuf>,
+
     #[arg(short, long, help = "Only print warnings/errors to stdout")]
     quiet: bool,
 
@@ -131,13 +139,35 @@ mod tests {
     }
 }
 
+/// Load the analyzer selection from a rayhunter config file's `[analyzers]`
+/// table, or the built-in defaults when no `--config` is given. Without this,
+/// the tool always runs `AnalyzerConfig::default()` and silently skips every
+/// analyzer that is off by default, so offline re-analysis cannot exercise them
+/// (T-OR-113). Unknown keys in the file are ignored, so a full device
+/// `config.toml` works as-is.
+fn load_analyzer_config(path: Option<&std::path::Path>) -> AnalyzerConfig {
+    let Some(path) = path else {
+        return AnalyzerConfig::default();
+    };
+    #[derive(Deserialize)]
+    struct ConfigFile {
+        #[serde(default)]
+        analyzers: AnalyzerConfig,
+    }
+    let text = std::fs::read_to_string(path)
+        .unwrap_or_else(|e| panic!("failed to read --config {}: {e}", path.display()));
+    let parsed: ConfigFile = toml::from_str(&text)
+        .unwrap_or_else(|e| panic!("failed to parse --config {}: {e}", path.display()));
+    parsed.analyzers
+}
+
 async fn analyze_pcap(
     pcap_path: &str,
     show_skipped: bool,
+    config: &AnalyzerConfig,
     json_writer: Option<&mut IncrementalJsonWriter<File>>,
 ) {
-    let mut harness =
-        Harness::new_with_config(&AnalyzerConfig::default(), &DeviceMetadata::default());
+    let mut harness = Harness::new_with_config(config, &DeviceMetadata::default());
     let pcap_file = &mut File::open(&pcap_path).await.expect("failed to open file");
     let mut pcap_reader = PcapNgReader::new(pcap_file)
         .await
@@ -165,10 +195,10 @@ async fn analyze_pcap(
 async fn analyze_qmdl(
     qmdl_path: &str,
     show_skipped: bool,
+    config: &AnalyzerConfig,
     json_writer: Option<&mut IncrementalJsonWriter<File>>,
 ) {
-    let mut harness =
-        Harness::new_with_config(&AnalyzerConfig::default(), &DeviceMetadata::default());
+    let mut harness = Harness::new_with_config(config, &DeviceMetadata::default());
     let qmdl_file = &mut File::open(&qmdl_path).await.expect("failed to open file");
     let mut qmdl_reader = QmdlMessageReader::new(qmdl_file)
         .await
@@ -233,7 +263,8 @@ async fn main() {
     };
     rayhunter::init_logging(level);
 
-    let harness = Harness::new_with_config(&AnalyzerConfig::default(), &DeviceMetadata::default());
+    let analyzer_config = load_analyzer_config(args.config.as_deref());
+    let harness = Harness::new_with_config(&analyzer_config, &DeviceMetadata::default());
     let metadata = harness.get_metadata();
     info!("Analyzers:");
     for analyzer in &metadata.analyzers {
@@ -271,14 +302,26 @@ async fn main() {
         let path_str = path.to_str().unwrap();
         if name_str.ends_with(".qmdl") || name_str.ends_with(".qmdl.gz") {
             info!("**** Beginning analysis of {name_str}");
-            analyze_qmdl(path_str, args.show_skipped, json_writer.as_mut()).await;
+            analyze_qmdl(
+                path_str,
+                args.show_skipped,
+                &analyzer_config,
+                json_writer.as_mut(),
+            )
+            .await;
             if args.pcapify {
                 pcapify(&path.to_path_buf()).await;
             }
         } else if name_str.ends_with(".pcap") || name_str.ends_with(".pcapng") {
             // TODO: if we've already analyzed a QMDL, skip its corresponding pcap
             info!("**** Beginning analysis of {name_str}");
-            analyze_pcap(path_str, args.show_skipped, json_writer.as_mut()).await;
+            analyze_pcap(
+                path_str,
+                args.show_skipped,
+                &analyzer_config,
+                json_writer.as_mut(),
+            )
+            .await;
         }
     }
 
