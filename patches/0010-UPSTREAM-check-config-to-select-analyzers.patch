+
+/// Load the analyzer selection from a rayhunter config file's `[analyzers]`
+/// table, or the built-in defaults when no `--config` is given. Without this,
+/// the tool always runs `AnalyzerConfig::default()` and silently skips every
+/// analyzer that is off by default, so offline re-analysis cannot exercise them
+/// (T-OR-113). Unknown keys in the file are ignored, so a full device
+/// `config.toml` works as-is.
+fn load_analyzer_config(path: Option<&std::path::Path>) -> AnalyzerConfig {
+    let Some(path) = path else {
+        return AnalyzerConfig::default();
+    };
+    #[derive(Deserialize)]
+    struct ConfigFile {
+        #[serde(default)]
+        analyzers: AnalyzerConfig,
     }
+    let text = std::fs::read_to_string(path)
+        .unwrap_or_else(|e| panic!("failed to read --config {}: {e}", path.display()));
+    let parsed: ConfigFile = toml::from_str(&text)
+        .unwrap_or_else(|e| panic!("failed to parse --config {}: {e}", path.display()));
+    parsed.analyzers
+}
+
+/// The ordered analyzer names for a harness. `AnalysisRow::events` is indexed by
+/// analyzer position, so `Report::process_row` uses this to label each event.
+fn analyzer_names(harness: &Harness) -> Vec<String> {
+    harness
+        .get_metadata()
+        .analyzers
+        .iter()
+        .map(|a| a.name.clone())
+        .collect()
 }
 
