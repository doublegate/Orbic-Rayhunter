+/// The base of a Gotify URL: everything before any query/fragment, with a
+/// trailing slash trimmed. The Gotify token belongs in `gotify_token` (sent as
+/// `X-Gotify-Key`, redacted from `GET /api/config`), never in the URL.
+pub(crate) fn gotify_base_url(url: &str) -> String {
+    url.split(['?', '#'])
+        .next()
+        .unwrap_or(url)
+        .trim_end_matches('/')
+        .to_string()
