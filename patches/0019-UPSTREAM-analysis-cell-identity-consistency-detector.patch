diff --git a/lib/src/analysis/cell_consistency.rs b/lib/src/analysis/cell_consistency.rs
new file mode 100644
index 0000000..80e6150
--- /dev/null
+++ b/lib/src/analysis/cell_consistency.rs
@@ -0,0 +1,240 @@
+//! Flags a cell that is inconsistent with itself across one recording: the same
+//! E-UTRAN cell identity advertised with two different tracking area codes, or
+//! the same cell identity measured on two different physical cell ids (PCI).
+//!
+//! A real eNB cell has one fixed (cell identity, TAC, PCI). A false base station
+//! that clones a legitimate cell's identity, or rotates identifiers to evade
+//! correlation, produces a mismatch within a single recording. This is a weak
+//! signal on its own -- it corroborates the NAS/RRC detectors on the same cell
+//! -- so it is Low and off by default pending T-OR-061 calibration.
+//!
+//! State is per recording and holds only the FIRST value seen per cell identity;
+//! it is reset implicitly by starting a new recording (a new analyzer instance).
+//!
+//! Inputs:
+//! - RRC SIB1 (`BcchDlSch` -> `SystemInformationBlockType1`) gives the serving
+//!   cell's `cellIdentity` and `trackingAreaCode`.
+//! - ML1 serving measurements (via [`Analyzer::report_measurement`], T-OR-058)
+//!   give the serving cell's PCI, correlated with the most recent SIB1's cell
+//!   identity. These are RRC_IDLE logs, so the PCI check covers idle mode.
+//!
+//! Privacy: the analyzer compares cell-identity / TAC bit patterns and PCI
+//! values but never puts any of them in an event; it reports only that a
+//! mismatch occurred, not the identifiers involved.
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+
+use chrono::{DateTime, FixedOffset};
+use telcom_parser::lte_rrc::{BCCH_DL_SCH_MessageType, BCCH_DL_SCH_MessageType_c1};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+use super::measurement::Ml1Measurement;
+
+/// A cell identity / tracking area code reduced to its raw bytes, for comparison
+/// as a map key. Equal bit patterns yield equal bytes; the values are never
+/// logged.
+type Bits = Vec<u8>;
+
+#[derive(Default)]
+pub struct CellConsistencyAnalyzer {
+    /// cell identity -> the first tracking area code seen with it.
+    tac_by_cell: HashMap<Bits, Bits>,
+    /// cell identity -> the first serving PCI seen with it.
+    pci_by_cell: HashMap<Bits, u16>,
+    /// The cell identity of the most recently decoded serving SIB1, used to
+    /// attribute a serving-cell PCI measurement to a cell identity.
+    last_serving_cell: Option<Bits>,
+}
+
+impl CellConsistencyAnalyzer {
+    fn event(detail: &str) -> Event {
+        Event {
+            event_type: EventType::Low,
+            message: format!(
+                "A cell was inconsistent with itself within one recording: {detail}. A real cell \
+                 has one fixed identity, tracking area and physical cell id; a mismatch can be \
+                 identifier cloning or rotation by a false base station"
+            ),
+        }
+    }
+}
+
+impl Analyzer for CellConsistencyAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Cell identity consistency")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags a cell inconsistent with itself across one recording: the same E-UTRAN cell \
+             identity (from SIB1) advertised with two different tracking area codes, or measured \
+             (idle-mode ML1) on two different physical cell ids. Corroborative and Low; off by \
+             default pending calibration. Compares identifiers but never reports their values.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::BcchDlSch(sch) = lte.as_ref() else {
+            return None;
+        };
+        let BCCH_DL_SCH_MessageType::C1(BCCH_DL_SCH_MessageType_c1::SystemInformationBlockType1(
+            sib1,
+        )) = &sch.message
+        else {
+            return None;
+        };
+        let cari = &sib1.cell_access_related_info;
+        let cell = cari.cell_identity.0.clone().into_vec();
+        let tac = cari.tracking_area_code.0.clone().into_vec();
+        self.last_serving_cell = Some(cell.clone());
+
+        match self.tac_by_cell.get(&cell) {
+            Some(seen) if *seen != tac => Some(Self::event(
+                "the same cell identity was announced with two tracking area codes",
+            )),
+            Some(_) => None,
+            None => {
+                self.tac_by_cell.insert(cell, tac);
+                None
+            }
+        }
+    }
+
+    fn report_measurement(
+        &mut self,
+        measurement: &Ml1Measurement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let Ml1Measurement::ServingCell(serving) = measurement else {
+            return None;
+        };
+        let cell = self.last_serving_cell.clone()?;
+        match self.pci_by_cell.get(&cell) {
+            Some(seen) if *seen != serving.pci => Some(Self::event(
+                "the same cell identity appeared on two physical cell ids",
+            )),
+            Some(_) => None,
+            None => {
+                self.pci_by_cell.insert(cell, serving.pci);
+                None
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::measurement::Ml1ServingCell;
+    use crate::analysis::test_util::{bcch_dl_sch, hex, packet_time};
+
+    // SIB1 PDUs encoded with the reference Python pycrate (TS 36.331, PLMN
+    // 001/01) and decoded through telcom_parser.
+    // cellIdentity A=0x0ABCDEF; TAC 0x0001 / 0x0002. cellIdentity B=0x1234567.
+    const SIB1_A_TAC1: &str = "4040040300010ABCDEF8000080108280";
+    const SIB1_A_TAC2: &str = "4040040300020ABCDEF8000080108280";
+    const SIB1_B_TAC1: &str = "40400403000112345678000080108280";
+
+    fn sib1(v: &str) -> InformationElement {
+        bcch_dl_sch(&hex(v))
+    }
+
+    fn serving(pci: u16) -> Ml1Measurement {
+        Ml1Measurement::ServingCell(Ml1ServingCell::new(pci, 6300, -100.0))
+    }
+
+    #[test]
+    fn same_cell_identity_two_tacs_fires() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(
+            a.analyze_information_element(&sib1(SIB1_A_TAC1), 0, packet_time(0))
+                .is_none()
+        );
+        let ev = a
+            .analyze_information_element(&sib1(SIB1_A_TAC2), 1, packet_time(1))
+            .expect("mismatch fires");
+        assert_eq!(ev.event_type, EventType::Low);
+        assert!(ev.message.contains("tracking area"));
+        // The event must not leak the identifiers.
+        assert!(!ev.message.contains("0001") && !ev.message.contains("0002"));
+    }
+
+    #[test]
+    fn same_cell_identity_same_tac_is_quiet() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(
+            a.analyze_information_element(&sib1(SIB1_A_TAC1), 0, packet_time(0))
+                .is_none()
+        );
+        assert!(
+            a.analyze_information_element(&sib1(SIB1_A_TAC1), 1, packet_time(1))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn different_cell_identities_are_quiet() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(
+            a.analyze_information_element(&sib1(SIB1_A_TAC1), 0, packet_time(0))
+                .is_none()
+        );
+        assert!(
+            a.analyze_information_element(&sib1(SIB1_B_TAC1), 1, packet_time(1))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn same_cell_identity_two_pcis_fires() {
+        let mut a = CellConsistencyAnalyzer::default();
+        a.analyze_information_element(&sib1(SIB1_A_TAC1), 0, packet_time(0));
+        assert!(
+            a.report_measurement(&serving(214), 1, packet_time(1))
+                .is_none()
+        );
+        let ev = a
+            .report_measurement(&serving(425), 2, packet_time(2))
+            .expect("pci mismatch fires");
+        assert_eq!(ev.event_type, EventType::Low);
+        assert!(ev.message.contains("physical cell id"));
+    }
+
+    #[test]
+    fn same_cell_identity_same_pci_is_quiet() {
+        let mut a = CellConsistencyAnalyzer::default();
+        a.analyze_information_element(&sib1(SIB1_A_TAC1), 0, packet_time(0));
+        assert!(
+            a.report_measurement(&serving(214), 1, packet_time(1))
+                .is_none()
+        );
+        assert!(
+            a.report_measurement(&serving(214), 2, packet_time(2))
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn a_measurement_before_any_sib1_is_quiet() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(
+            a.report_measurement(&serving(214), 0, packet_time(0))
+                .is_none()
+        );
+    }
+}
