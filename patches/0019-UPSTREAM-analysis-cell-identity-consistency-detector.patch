index 0000000..02e8d2a
--- /dev/null
+++ b/lib/src/analysis/cell_consistency.rs
@@ -0,0 +1,357 @@
+//! Flags an E-UTRAN cell that advertises the same cell identity (ECGI) with two
+//! different tracking area codes within one recording.
+//!
+//! A real eNB cell has one fixed (ECGI, TAC): the ECGI identifies the cell and
+//! the TAC the tracking area it belongs to. A false base station that clones a
+//! legitimate cell's ECGI, or rotates the TAC to evade correlation, advertises
+//! the same ECGI under two TACs in one recording. This corroborates the NAS/RRC
+//! detectors on the same cell rather than standing alone, so it is Low and off
+//! by default pending T-OR-061 calibration.
+//!
+//! The cell key is the full ECGI -- primary PLMN (MCC+MNC) plus the 28-bit
+//! `cellIdentity` -- because `cellIdentity` is only unique within a PLMN, so two
+//! PLMNs (roaming, border areas) can legitimately share one `cellIdentity`.
+//! A SIB1 whose primary PLMN is missing its mandatory MCC (TS 36.331 6.2.2) is
+//! skipped rather than tracked under a partial key.
+//!
+//! State is per recording: for each ECGI, the first TAC seen or a "reported"
+//! marker (so each mismatch fires once, not on every repeated SIB1), in one
+//! bounded map so a long recording or a SIB1 flood of untrusted broadcast
+//! identities cannot exhaust memory on the device.
+//!
+//! Limitations (tracked under T-OR-118):
+//! - Correlating the ECGI with the serving PCI (an ML1 measurement) is deferred:
+//!   a serving measurement cannot be reliably attributed to a cell across
+//!   idle-mode reselection without the per-SIB1 PCI or calibrated hysteresis.
+//! - Only the FIRST PLMN of a RAN-shared (MOCN) `plmn-IdentityList` is keyed, so
+//!   a clone that reorders the list would not match the original ECGI.
+//! - Past `MAX_TRACKED_CELLS` distinct cells the analyzer stops tracking NEW
+//!   cells for the rest of the recording (already-tracked cells still fire), so
+//!   a pre-flood of bogus SIB1s can blind it. A one-shot Informational event
+//!   marks when the cap is hit so the blind spot is visible; bounded eviction is
+//!   future work.
+//!
+//! Privacy: compares the ECGI and TAC but never puts either in an event; it
+//! reports only that a mismatch occurred.
+
+use std::borrow::Cow;
+use std::collections::HashMap;
+
+use chrono::{DateTime, FixedOffset};
+use telcom_parser::lte_rrc::{
+    BCCH_DL_SCH_MessageType, BCCH_DL_SCH_MessageType_c1, MCC_MNC_Digit, PLMN_Identity,
+};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+/// Cap on distinct ECGIs tracked in one recording. Keys come from untrusted OTA
+/// SIB1 broadcasts (2^28 cell identities per PLMN), so the map stops tracking
+/// new cells past this to bound memory on the MDM9207.
+const MAX_TRACKED_CELLS: usize = 4096;
+
+/// A cell's global identity, as a small `Copy` key (no per-SIB1 heap churn).
+/// MCC is 3 digits; MNC is 2 or 3, so `mnc_len` keeps `01` distinct from `001`.
+/// Never logged.
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+struct Ecgi {
+    mcc: [u8; 3],
+    mnc: [u8; 3],
+    mnc_len: u8,
+    eci: u32,
+}
+
+impl Ecgi {
+    /// Build an ECGI from a SIB1 primary PLMN and 28-bit cell identity, or `None`
+    /// if the PLMN is malformed (MCC absent/not 3 digits, MNC not 2-3 digits).
+    fn new(plmn: &PLMN_Identity, eci: u32) -> Option<Self> {
+        let mcc_digits = plmn.mcc.as_ref()?;
+        if mcc_digits.0.len() != 3 {
+            return None;
+        }
+        let mut mcc = [0u8; 3];
+        for (slot, MCC_MNC_Digit(n)) in mcc.iter_mut().zip(&mcc_digits.0) {
+            *slot = *n;
+        }
+        let mnc_len = plmn.mnc.0.len();
+        if mnc_len != 2 && mnc_len != 3 {
+            return None;
+        }
+        let mut mnc = [0u8; 3];
+        for (slot, MCC_MNC_Digit(n)) in mnc.iter_mut().zip(&plmn.mnc.0) {
+            *slot = *n;
+        }
+        Some(Ecgi {
+            mcc,
+            mnc,
+            mnc_len: mnc_len as u8,
+            eci,
+        })
+    }
+}
+
+/// Per-cell state: the first TAC seen, or already reported inconsistent.
+enum CellState {
+    Seen(u16),
+    Reported,
+}
+
+#[derive(Default)]
+pub struct CellConsistencyAnalyzer {
+    cells: HashMap<Ecgi, CellState>,
+    /// Set once the cap is hit, so the saturation diagnostic fires only once.
+    saturated_reported: bool,
+}
+
+impl CellConsistencyAnalyzer {
+    fn event() -> Event {
+        Event {
+            event_type: EventType::Low,
+            message: "A cell announced the same identity (ECGI) with two different tracking area \
+                      codes within one recording. A real cell has one fixed tracking area; a \
+                      mismatch can be identity cloning or tracking-area rotation by a false base \
+                      station"
+                .to_string(),
+        }
+    }
+
+    fn saturation_event() -> Event {
+        Event {
+            event_type: EventType::Informational,
+            message: format!(
+                "Cell-identity tracking saturated at {MAX_TRACKED_CELLS} cells in this recording; \
+                 new cells are no longer checked for consistency (a long recording or a SIB1 \
+                 identity flood)"
+            ),
+        }
+    }
+}
+
+impl Analyzer for CellConsistencyAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Cell identity consistency")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags an E-UTRAN cell that advertises the same identity (ECGI = PLMN + cellIdentity, \
+             from SIB1) with two different tracking area codes within one recording -- possible \
+             identity cloning or tracking-area rotation by a false base station. Corroborative and \
+             Low; fires once per cell; off by default pending calibration. Compares identifiers but \
+             never reports their values.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::BcchDlSch(sch) = lte.as_ref() else {
+            return None;
+        };
+        let BCCH_DL_SCH_MessageType::C1(BCCH_DL_SCH_MessageType_c1::SystemInformationBlockType1(
+            sib1,
+        )) = &sch.message
+        else {
+            return None;
+        };
+        let cari = &sib1.cell_access_related_info;
+        // Fold the big-endian bit strings into integers (ECI 28 bits, TAC 16).
+        let eci = cari
+            .cell_identity
+            .0
+            .iter()
+            .fold(0u32, |acc, b| (acc << 1) | (*b as u32));
+        let tac = cari
+            .tracking_area_code
+            .0
+            .iter()
+            .fold(0u16, |acc, b| (acc << 1) | u16::from(*b));
+        let ecgi = Ecgi::new(&cari.plmn_identity_list.0.first()?.plmn_identity, eci)?;
+
+        match self.cells.get(&ecgi) {
+            Some(CellState::Reported) => None,
+            Some(CellState::Seen(seen)) if *seen != tac => {
+                self.cells.insert(ecgi, CellState::Reported);
+                Some(Self::event())
+            }
+            Some(CellState::Seen(_)) => None,
+            None => {
+                // Bound memory: stop tracking NEW cells past the cap (already
+                // tracked cells still fire). Emit a one-shot diagnostic the first
+                // time the cap blocks a new cell, so the blind spot is visible.
+                if self.cells.len() < MAX_TRACKED_CELLS {
+                    self.cells.insert(ecgi, CellState::Seen(tac));
+                    None
+                } else if !self.saturated_reported {
+                    self.saturated_reported = true;
+                    Some(Self::saturation_event())
+                } else {
+                    None
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{bcch_dl_sch, hex, packet_time};
+
+    // SIB1 PDUs encoded with the reference Python pycrate (TS 36.331) and decoded
+    // through telcom_parser. cellIdentity A=0x0ABCDEF, B=0x1234567; TAC 1 / 2;
+    // A_PLMN2 reuses cellIdentity A under PLMN 002/01.
+    const A_PLMN1_TAC1: &str = "4040040300010ABCDEF8000080108280";
+    const A_PLMN1_TAC2: &str = "4040040300020ABCDEF8000080108280";
+    const B_PLMN1_TAC1: &str = "40400403000112345678000080108280";
+    const B_PLMN1_TAC2: &str = "40400403000212345678000080108280";
+    const A_PLMN2_TAC2: &str = "4040080300020ABCDEF8000080108280";
+
+    fn sib1(v: &str) -> InformationElement {
+        bcch_dl_sch(&hex(v))
+    }
+
+    fn run(a: &mut CellConsistencyAnalyzer, v: &str, p: usize) -> Option<Event> {
+        a.analyze_information_element(&sib1(v), p, packet_time(p as i64))
+    }
+
+    #[test]
+    fn same_ecgi_two_tacs_fires_once() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        let ev = run(&mut a, A_PLMN1_TAC2, 1).expect("mismatch fires");
+        assert_eq!(ev.event_type, EventType::Low);
+        assert!(ev.message.contains("tracking area"));
+        // Does not leak identifiers.
+        assert!(!ev.message.contains("0001") && !ev.message.contains("0002"));
+        // Fires once: a repeated mismatched SIB1 is quiet.
+        assert!(run(&mut a, A_PLMN1_TAC2, 2).is_none());
+        assert!(run(&mut a, A_PLMN1_TAC1, 3).is_none());
+    }
+
+    #[test]
+    fn same_ecgi_same_tac_is_quiet() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        assert!(run(&mut a, A_PLMN1_TAC1, 1).is_none());
+    }
+
+    #[test]
+    fn different_cell_identities_even_with_different_tacs_are_quiet() {
+        // Cell B on TAC2 after cell A on TAC1: a different cell identity, so no
+        // inconsistency. (A PLMN-only key would wrongly fire here.)
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        assert!(run(&mut a, B_PLMN1_TAC2, 1).is_none());
+    }
+
+    #[test]
+    fn same_cell_identity_different_plmn_is_quiet() {
+        // Same 28-bit cellIdentity under two PLMNs with different TACs is legal
+        // (cellIdentity is only unique within a PLMN) and must not fire.
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        assert!(run(&mut a, A_PLMN2_TAC2, 1).is_none());
+    }
+
+    #[test]
+    fn a_non_sib1_element_is_ignored() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(
+            a.analyze_information_element(&InformationElement::GSM, 0, packet_time(0))
+                .is_none()
+        );
+    }
+
+    fn synthetic_ecgi(eci: u32) -> Ecgi {
+        Ecgi {
+            mcc: [9, 9, 9],
+            mnc: [9, 9, 0],
+            mnc_len: 2,
+            eci,
+        }
+    }
+
+    #[test]
+    fn the_cap_bounds_new_cells_but_tracked_cells_still_fire() {
+        // Fill the map to exactly MAX_TRACKED_CELLS - 1 synthetic cells, plus
+        // cell A, so len == MAX_TRACKED_CELLS (encoding that many real SIB1 PDUs
+        // is impractical; the test module can reach the private map directly).
+        let mut a = CellConsistencyAnalyzer::default();
+        run(&mut a, A_PLMN1_TAC1, 0); // cell A: Seen(TAC1)
+        for eci in 0..(MAX_TRACKED_CELLS as u32 - 1) {
+            a.cells.insert(synthetic_ecgi(eci), CellState::Seen(1));
+        }
+        assert_eq!(a.cells.len(), MAX_TRACKED_CELLS, "exactly at the cap");
+
+        // A brand-new cell at the cap is NOT tracked, and the one-shot
+        // saturation diagnostic fires (Informational).
+        let before = a.cells.len();
+        let ev = run(&mut a, B_PLMN1_TAC1, 1).expect("saturation diagnostic");
+        assert_eq!(ev.event_type, EventType::Informational);
+        assert_eq!(
+            a.cells.len(),
+            before,
+            "new cell past the cap is not tracked"
+        );
+        // The diagnostic fires only once.
+        assert!(run(&mut a, B_PLMN1_TAC2, 2).is_none());
+        // Cell A, tracked before the cap, still fires on a different TAC.
+        assert!(run(&mut a, A_PLMN1_TAC2, 3).is_some());
+    }
+
+    #[test]
+    fn two_cells_fire_independently() {
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        assert!(run(&mut a, B_PLMN1_TAC1, 1).is_none());
+        // A's own TAC change fires; B is unaffected and still fires on its own.
+        assert!(run(&mut a, A_PLMN1_TAC2, 2).is_some());
+        assert!(run(&mut a, B_PLMN1_TAC2, 3).is_some());
+    }
+
+    #[test]
+    fn same_cell_identity_two_vs_three_digit_mnc_is_quiet() {
+        // PLMN 001/01 then 001/010 (same cellIdentity, different MNC length) are
+        // distinct ECGIs: 01 != 010, so no inconsistency even on different TACs.
+        const A_PLMN_3DIGIT_MNC_TAC2: &str = "40400602100020ABCDEF80000801082800";
+        let mut a = CellConsistencyAnalyzer::default();
+        assert!(run(&mut a, A_PLMN1_TAC1, 0).is_none());
+        assert!(run(&mut a, A_PLMN_3DIGIT_MNC_TAC2, 1).is_none());
+    }
+
+    fn plmn(mcc: Option<&[u8]>, mnc: &[u8]) -> PLMN_Identity {
+        use telcom_parser::lte_rrc::{MCC, MNC};
+        PLMN_Identity {
+            mcc: mcc.map(|d| MCC(d.iter().map(|n| MCC_MNC_Digit(*n)).collect())),
+            mnc: MNC(mnc.iter().map(|n| MCC_MNC_Digit(*n)).collect()),
+        }
+    }
+
+    #[test]
+    fn ecgi_new_rejects_malformed_plmn() {
+        // Missing MCC (mandatory in the primary PLMN), wrong MCC length, and a
+        // bad MNC length all yield None rather than a partial key.
+        assert!(Ecgi::new(&plmn(None, &[0, 1]), 1).is_none());
+        assert!(Ecgi::new(&plmn(Some(&[0, 0]), &[0, 1]), 1).is_none());
+        assert!(Ecgi::new(&plmn(Some(&[0, 0, 1]), &[0]), 1).is_none());
+        assert!(Ecgi::new(&plmn(Some(&[0, 0, 1]), &[0, 1, 2, 3]), 1).is_none());
+    }
+
+    #[test]
+    fn ecgi_new_distinguishes_two_and_three_digit_mnc() {
+        let two = Ecgi::new(&plmn(Some(&[0, 0, 1]), &[0, 1]), 1).unwrap();
+        let three = Ecgi::new(&plmn(Some(&[0, 0, 1]), &[0, 1, 0]), 1).unwrap();
+        assert_ne!(two, three, "01 and 010 must be different ECGIs");
+    }
+}
