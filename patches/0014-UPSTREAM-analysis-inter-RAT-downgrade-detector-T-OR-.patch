+//! Flags network-directed moves off LTE toward a legacy or sunset radio access
+//! technology -- the "push the UE down to a weaker RAT" step of a downgrade
+//! attack, complementing the broadcast-reselection analyzers
+//! (`priority_2g_downgrade` for SIB6/7, `connection_redirect_downgrade` for an
+//! RRC Connection Release redirect).
+//!
+//! - A **MobilityFromEUTRACommand** is an explicit, per-UE command to leave LTE.
+//!   Both its `CellChangeOrder` (always to GERAN in TS 36.331) and its
+//!   `Handover` purpose can direct the UE to 2G/GERAN -- a directed downgrade
+//!   onto a weaker, more interceptable RAT (High). A `Handover` to 3G/UTRA or
+//!   CDMA2000, and an `e-CSFB` to CDMA2000, are lesser moves off LTE that can be
+//!   legitimate (Informational). A handover to NR (5G) or back to E-UTRA is not
+//!   a downgrade and is ignored.
+//! - **SIB8** is broadcast by a cell that supports CDMA2000 interworking.
+//!   CDMA2000 is decommissioned across the US (and much of the world), so a cell
+//!   still broadcasting SIB8 is anomalous -- Low, since where CDMA2000 still runs
+//!   it is legitimate (a per-MCC sunset policy to raise it is tracked as
+//!   T-OR-115). SIB8 repeats on BCCH, so with this detector enabled in a market
+//!   that still broadcasts it, expect a Low event per SIB8 repetition.
+//!
+//! Stateless: keys on the message/IE presence alone. Off by default pending
+//! per-market calibration (a genuine inter-RAT handover is a Handover command,
+//! and SIB8 is legitimate where CDMA2000 still runs).
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use telcom_parser::lte_rrc::{
+    BCCH_DL_SCH_MessageType, BCCH_DL_SCH_MessageType_c1, DL_DCCH_MessageType,
+    DL_DCCH_MessageType_c1, HandoverTargetRAT_Type, MobilityFromEUTRACommand_r8_IEsPurpose,
+    MobilityFromEUTRACommand_r9_IEsPurpose, MobilityFromEUTRACommandCriticalExtensions,
+    MobilityFromEUTRACommandCriticalExtensions_c1, SystemInformation_r8_IEsSib_TypeAndInfo_Entry,
+    SystemInformationCriticalExtensions,
+};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct RatDowngradeAnalyzer;
+
+/// What a MobilityFromEUTRACommand directs the UE to do, normalized across the
+/// r8/r9 purpose choices.
+enum Purpose {
+    /// CellChangeOrder: always to GERAN (2G) in TS 36.331.
+    CellChangeOrderToGeran,
+    /// Handover, carrying the target RAT enumeration value.
+    Handover(u8),
+    /// e-CSFB (r9): fallback onto CDMA2000 1xRTT/HRPD.
+    ECsfb,
+    /// Anything this analyzer does not act on.
+    Other,
+}
+
+/// Name only the targets the Informational arm actually reports (3G/UTRA and
+/// CDMA2000); GERAN is handled separately, and NR/E-UTRA never reach here.
+fn name_target_rat(target: u8) -> &'static str {
+    match target {
+        HandoverTargetRAT_Type::UTRA => "3G/UTRA",
+        HandoverTargetRAT_Type::CDMA2000_1XRTT => "CDMA2000 1xRTT",
+        HandoverTargetRAT_Type::CDMA2000_HRPD => "CDMA2000 HRPD",
+        _ => "a legacy RAT",
+    }
+}
+
+/// A " (marked CS fallback)" suffix when the command set cs-FallbackIndicator,
+/// which usually means a legitimate voice-call fallback rather than a forced
+/// downgrade -- useful context during calibration.
+fn csfb_suffix(csfb: bool) -> &'static str {
+    if csfb { " (marked CS fallback)" } else { "" }
+}
+
+fn purpose_event(p: Purpose, csfb: bool) -> Option<Event> {
+    match p {
+        Purpose::CellChangeOrderToGeran => Some(Event {
+            event_type: EventType::High,
+            message: format!(
+                "Network ordered a cell change to 2G/GERAN (MobilityFromEUTRACommand \
+                 CellChangeOrder) -- a directed downgrade off LTE{}",
+                csfb_suffix(csfb)
+            ),
+        }),
+        Purpose::Handover(target) => match target {
+            // A handover command that targets 2G is a directed downgrade.
+            HandoverTargetRAT_Type::GERAN => Some(Event {
+                event_type: EventType::High,
+                message: format!(
+                    "Network commanded a handover to 2G/GERAN (MobilityFromEUTRACommand \
+                     Handover) -- a directed downgrade off LTE{}",
+                    csfb_suffix(csfb)
+                ),
+            }),
+            // 3G/UTRA and CDMA2000 handovers are lesser moves off LTE that can be
+            // legitimate.
+            HandoverTargetRAT_Type::UTRA
+            | HandoverTargetRAT_Type::CDMA2000_1XRTT
+            | HandoverTargetRAT_Type::CDMA2000_HRPD => Some(Event {
+                event_type: EventType::Informational,
+                message: format!(
+                    "Network commanded an inter-RAT handover off LTE to {} \
+                     (MobilityFromEUTRACommand Handover){}",
+                    name_target_rat(target),
+                    csfb_suffix(csfb)
+                ),
+            }),
+            // NR (5G) and E-UTRA are not downgrades; any other (spare/unknown)
+            // code is left alone rather than guessed at.
+            HandoverTargetRAT_Type::NR | HandoverTargetRAT_Type::EUTRA => None,
+            _ => None,
+        },
+        Purpose::ECsfb => Some(Event {
+            event_type: EventType::Informational,
+            message: "Network directed an e-CSFB to CDMA2000 (MobilityFromEUTRACommand) -- a \
+                      fallback off LTE"
+                .to_string(),
+        }),
+        Purpose::Other => None,
+    }
+}
+
+impl Analyzer for RatDowngradeAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Inter-RAT downgrade command / sunset-RAT advertisement")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags a network-directed move off LTE toward a legacy RAT: a MobilityFromEUTRACommand \
+             with a CellChangeOrder or a Handover to 2G/GERAN (High), a Handover or e-CSFB to \
+             3G/UTRA or CDMA2000 (Informational), or an LTE cell broadcasting CDMA2000 interworking \
+             (SIB8, Low -- anomalous where CDMA2000 is decommissioned). A handover to NR (5G) or \
+             E-UTRA is ignored. Complements the broadcast-reselection analyzers \
+             (priority_2g_downgrade for SIB6/7, connection_redirect_downgrade for a Connection \
+             Release redirect). Stateless; SIB8 repeats on BCCH, so enabling it in a CDMA2000 \
+             market yields a Low event per repetition. Off by default pending per-market \
+             calibration.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        match lte.as_ref() {
+            LteInformationElement::DlDcch(msg) => {
+                let DL_DCCH_MessageType::C1(DL_DCCH_MessageType_c1::MobilityFromEUTRACommand(cmd)) =
+                    &msg.message
+                else {
+                    return None;
+                };
+                let MobilityFromEUTRACommandCriticalExtensions::C1(c1) = &cmd.critical_extensions
+                else {
+                    return None;
+                };
+                let (purpose, csfb) = match c1 {
+                    MobilityFromEUTRACommandCriticalExtensions_c1::MobilityFromEUTRACommand_r8(
+                        r8,
+                    ) => {
+                        let p = match &r8.purpose {
+                            MobilityFromEUTRACommand_r8_IEsPurpose::CellChangeOrder(_) => {
+                                Purpose::CellChangeOrderToGeran
+                            }
+                            MobilityFromEUTRACommand_r8_IEsPurpose::Handover(h) => {
+                                Purpose::Handover(h.target_rat_type.0)
+                            }
+                        };
+                        (p, r8.cs_fallback_indicator.0)
+                    }
+                    MobilityFromEUTRACommandCriticalExtensions_c1::MobilityFromEUTRACommand_r9(
+                        r9,
+                    ) => {
+                        let p = match &r9.purpose {
+                            MobilityFromEUTRACommand_r9_IEsPurpose::CellChangeOrder(_) => {
+                                Purpose::CellChangeOrderToGeran
+                            }
+                            MobilityFromEUTRACommand_r9_IEsPurpose::Handover(h) => {
+                                Purpose::Handover(h.target_rat_type.0)
+                            }
+                            MobilityFromEUTRACommand_r9_IEsPurpose::E_CSFB_r9(_) => Purpose::ECsfb,
+                        };
+                        (p, r9.cs_fallback_indicator.0)
+                    }
+                    _ => (Purpose::Other, false),
+                };
+                purpose_event(purpose, csfb)
+            }
+            LteInformationElement::BcchDlSch(msg) => {
+                let BCCH_DL_SCH_MessageType::C1(BCCH_DL_SCH_MessageType_c1::SystemInformation(si)) =
+                    &msg.message
+                else {
+                    return None;
+                };
+                let SystemInformationCriticalExtensions::SystemInformation_r8(sib) =
+                    &si.critical_extensions
+                else {
+                    return None;
+                };
+                let has_sib8 =
+                    sib.sib_type_and_info.0.iter().any(|e| {
+                        matches!(e, SystemInformation_r8_IEsSib_TypeAndInfo_Entry::Sib8(_))
+                    });
+                has_sib8.then(|| Event {
+                    event_type: EventType::Low,
+                    message: "LTE cell broadcasts CDMA2000 interworking (SIB8) -- anomalous where \
+                              CDMA2000 is decommissioned"
+                        .to_string(),
+                })
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{bcch_dl_sch, collect_events, dl_dcch, packet_time};
+
+    fn hex(s: &str) -> Vec<u8> {
+        assert_eq!(s.len() % 2, 0, "odd-length hex vector");
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    // Vectors encoded with the reference Python pycrate (TS 36.331 ASN.1) and
+    // decoded here through telcom_parser -- two independent implementations.
+    // DL-DCCH MobilityFromEUTRACommand, r8 CellChangeOrder -> GERAN.
+    const CELL_CHANGE_GERAN: &str = "1808000140";
+    // r8 Handover -> GERAN (1) / UTRA (0) / NR (4).
+    const HANDOVER_GERAN: &str = "1800202000";
+    const HANDOVER_UTRA: &str = "1800002000";
+    const HANDOVER_NR: &str = "1800802000";
+    // r8 Handover -> CDMA2000 1xRTT (value 2), and GERAN with cs-FallbackIndicator set.
+    const HANDOVER_CDMA: &str = "1800402000";
+    const HANDOVER_GERAN_CSFB: &str = "1810202000";
+    // A SIB1 on BCCH-DL-SCH (a non-SystemInformation BCCH message): must not fire.
+    const BCCH_SIB1: &str = "404004030001000000180000005000";
+    // r9 CellChangeOrder -> GERAN, and r9 e-CSFB.
+    const CELL_CHANGE_R9_GERAN: &str = "1842000050";
+    const ECSFB_R9: &str = "184400";
+    // BCCH-DL-SCH SystemInformation carrying SIB8.
+    const SIB8_BCCH: &str = "001880";
+    // A real BCCH-DL-SCH SystemInformation with SIBs but no SIB8 (the T-OR-112
+    // identifier-free vector): must not fire.
+    const BCCH_NO_SIB8: &str =
+        "00025b30542fdb28c44605a28158000c032073bd156124000c026dd096af81c6892003c00310030000";
+    // DL-DCCH RRCConnectionReconfiguration (benign, not a mobility command).
+    const BENIGN_DLDCCH: &str = "200200";
+
+    fn run_dl(v: &str) -> Vec<(usize, Event)> {
+        let mut a = RatDowngradeAnalyzer;
+        collect_events(&mut a, &[(dl_dcch(&hex(v)), packet_time(0))])
+    }
+    fn run_bcch(v: &str) -> Vec<(usize, Event)> {
+        let mut a = RatDowngradeAnalyzer;
+        collect_events(&mut a, &[(bcch_dl_sch(&hex(v)), packet_time(0))])
+    }
+
+    #[test]
+    fn cell_change_order_to_geran_is_high() {
+        for v in [CELL_CHANGE_GERAN, CELL_CHANGE_R9_GERAN] {
+            let events = run_dl(v);
+            assert_eq!(events.len(), 1, "{v}");
+            assert_eq!(events[0].1.event_type, EventType::High, "{v}");
+            assert!(events[0].1.message.contains("GERAN"), "{v}");
+        }
+    }
+
+    #[test]
+    fn handover_to_geran_is_high() {
+        let events = run_dl(HANDOVER_GERAN);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+        assert!(events[0].1.message.contains("GERAN"));
+    }
+
+    #[test]
+    fn handover_to_utra_is_informational() {
+        let events = run_dl(HANDOVER_UTRA);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Informational);
+        assert!(events[0].1.message.contains("UTRA"));
+    }
+
+    #[test]
+    fn handover_to_nr_is_ignored() {
+        // A handover to 5G is not a downgrade.
+        assert!(run_dl(HANDOVER_NR).is_empty());
+    }
+
+    #[test]
+    fn handover_to_cdma2000_is_informational() {
+        let events = run_dl(HANDOVER_CDMA);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Informational);
+        assert!(events[0].1.message.contains("CDMA2000"));
+    }
+
+    #[test]
+    fn cs_fallback_marked_handover_is_annotated() {
+        // A GERAN handover marked as CS fallback is still High, but the message
+        // flags it so calibration can tell legitimate voice fallbacks apart.
+        let events = run_dl(HANDOVER_GERAN_CSFB);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+        assert!(events[0].1.message.contains("CS fallback"));
+    }
+
+    #[test]
+    fn non_system_information_bcch_is_ignored() {
+        // A SIB1 message on BCCH-DL-SCH is not a SystemInformation container.
+        assert!(run_bcch(BCCH_SIB1).is_empty());
+    }
+
+    #[test]
+    fn ecsfb_is_informational() {
+        let events = run_dl(ECSFB_R9);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Informational);
+        assert!(events[0].1.message.contains("CDMA2000"));
+    }
+
+    #[test]
+    fn sib8_advertisement_is_low() {
+        let events = run_bcch(SIB8_BCCH);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Low);
+        assert!(events[0].1.message.contains("SIB8"));
+    }
+
+    #[test]
+    fn bcch_without_sib8_is_ignored() {
+        assert!(run_bcch(BCCH_NO_SIB8).is_empty());
+    }
+
+    #[test]
+    fn benign_dl_dcch_is_ignored() {
+        assert!(run_dl(BENIGN_DLDCCH).is_empty());
+    }
+
+    #[test]
+    fn non_lte_information_element_is_ignored() {
+        let mut a = RatDowngradeAnalyzer;
+        assert!(collect_events(&mut a, &[(InformationElement::GSM, packet_time(0))]).is_empty());
+    }
+}
