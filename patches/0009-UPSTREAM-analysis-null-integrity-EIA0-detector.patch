@@ -0,0 +1,159 @@
+//! Flags a NAS Security Mode Command that selects null integrity protection
+//! (EIA0). EIA0 leaves NAS signalling with no integrity protection at all, so the
+//! network cannot be authenticated and an attacker can forge or modify NAS
+//! messages. 3GPP permits EIA0 only for an unauthenticated emergency-services
+//! attach (TS 33.401 5.1.4.1); selecting it for any normal attach is a strong
+//! false-base-station signal and a harder indicator than null ciphering (EEA0),
+//! which merely leaves traffic unencrypted while keeping it authenticated.
+//!
+//! The companion `nas_null_cipher` analyzer covers the ciphering half (EEA0);
+//! this one covers the integrity half (EIA0). High severity, but off by default
+//! until calibrated, since a genuine emergency call legitimately uses EIA0.
+//!
+//! Scope: a Security Mode Command is always sent with security-header type 3
+//! (integrity protected with a new context, unciphered -- TS 24.301 4.4.4.3), and
+//! this `pycrate-rs` has no security-protected `NASMessage` variant, so the
+//! analyzer matches the unwrapped `NASMessage::EMMMessage` the DIAG pipeline
+//! delivers (as the companion `nas_null_cipher` does). EIA0 is a special case,
+//! though: a UE must REJECT an EIA0 Security Mode Command on a non-emergency
+//! attach (TS 24.301 5.4.3.5). If the baseband rejects it before emitting the
+//! plain NAS log (0xB0E2) and logs only the header-wrapped PDU (0xB0EC, SHT 3),
+//! this analyzer would miss a real attack -- that `nas_null_cipher` sees EEA0
+//! (which arrives with a valid, accepted integrity algorithm) does NOT prove the
+//! EIA0 path reaches the plain log. The T-OR-061 device plan must verify this
+//! EIA0 rejection path specifically, not assume parity with the EEA0 case.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use pycrate_rs::nas::NASMessage;
+use pycrate_rs::nas::emm::EMMMessage;
+use pycrate_rs::nas::generated::emm::emm_security_mode_command::NASSecAlgoIntegAlgo;
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct NullIntegrityAnalyzer;
+
+impl Analyzer for NullIntegrityAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Null integrity (EIA0) requested")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags a NAS Security Mode Command that selects the null integrity algorithm EIA0. \
+             EIA0 leaves NAS signalling unauthenticated, so the network identity cannot be verified \
+             and signalling can be forged -- a stronger false-base-station indicator than null \
+             ciphering (EEA0). 3GPP permits EIA0 only for an unauthenticated emergency-services \
+             attach, so a genuine emergency call is the main benign trigger.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::NAS(nas) = lte.as_ref() else {
+            return None;
+        };
+        if let NASMessage::EMMMessage(EMMMessage::EMMSecurityModeCommand(cmd)) = nas
+            && cmd.nas_sec_algo.inner.integ_algo
+                == NASSecAlgoIntegAlgo::EPSIntegrityAlgorithmEIA0Null
+        {
+            // Report the ciphering algorithm too: EEA0+EIA0 is the shape of a
+            // (plausibly emergency) null-security attach, whereas a non-null
+            // cipher with EIA0 is never valid even for emergency (TS 33.401
+            // 5.1.4.1), and it tells triage whether nas_null_cipher also fired.
+            return Some(Event {
+                event_type: EventType::High,
+                message: format!(
+                    "NAS Security Mode Command selected null integrity (EIA0); ciphering = {:?}",
+                    cmd.nas_sec_algo.inner.ciph_algo
+                ),
+            });
+        }
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, emm_message, packet_time};
+
+    // EMM Security Mode Command (TS 24.301 table 9.8.1).
+    const SECURITY_MODE_COMMAND: u8 = 93;
+    // A valid Security Mode Command body (adapted from the pycrate test vector
+    // 33 00 02 f0 70 c1): nas_sec_algo | nas_ksi | ue_sec_cap (len 2) | imeisv_req.
+    // Byte 0 is the NAS security algorithms octet: high nibble = ciphering algo,
+    // low nibble = integrity algo. 0x20 => EEA2 ciphering, EIA0 (null) integrity;
+    // 0x33 => EEA3/EIA3 (a real algorithm, the negative control).
+    const TAIL: [u8; 5] = [0x00, 0x02, 0xf0, 0x70, 0xc1];
+
+    fn run(nas_sec_algo: u8) -> Vec<(usize, Event)> {
+        let mut analyzer = NullIntegrityAnalyzer;
+        let mut body = vec![nas_sec_algo];
+        body.extend_from_slice(&TAIL);
+        collect_events(
+            &mut analyzer,
+            &[(emm_message(SECURITY_MODE_COMMAND, &body), packet_time(0))],
+        )
+    }
+
+    #[test]
+    fn eia0_null_integrity_is_high() {
+        let events = run(0x20); // EEA2 ciphering, EIA0 integrity
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+        assert!(events[0].1.message.contains("EIA0"));
+    }
+
+    #[test]
+    fn eia0_with_null_ciphering_is_high() {
+        // 0x00 = EEA0 ciphering + EIA0 integrity -- the realistic emergency /
+        // false-base-station case (both null).
+        let events = run(0x00);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+    }
+
+    #[test]
+    fn real_integrity_algorithm_is_not_flagged() {
+        assert!(run(0x33).is_empty()); // EEA3 ciphering, EIA3 integrity
+    }
+
+    #[test]
+    fn null_ciphering_with_real_integrity_is_not_flagged() {
+        // 0x02 = EEA0 ciphering (null) + EIA2 integrity (real). Guards against
+        // reading the ciphering nibble instead of the integrity nibble: this
+        // would wrongly flag if the analyzer keyed on ciph_algo.
+        assert!(run(0x02).is_empty());
+    }
+
+    #[test]
+    fn non_security_mode_command_is_ignored() {
+        // An Attach Reject (type 68) is EMM but not a Security Mode Command.
+        let mut analyzer = NullIntegrityAnalyzer;
+        assert!(
+            collect_events(&mut analyzer, &[(emm_message(68, &[22]), packet_time(0))]).is_empty()
+        );
+    }
+
+    #[test]
+    fn non_lte_information_element_is_ignored() {
+        let mut analyzer = NullIntegrityAnalyzer;
+        assert!(
+            collect_events(&mut analyzer, &[(InformationElement::GSM, packet_time(0))]).is_empty()
+        );
+    }
+}
