+//! Flags an RRC configuration that selects the null integrity algorithm (EIA0)
+//! for access-stratum signalling.
+//!
+//! EIA0 leaves RRC signalling integrity-unprotected: a UE that accepts it will
+//! act on unauthenticated RRC messages (measurement config, reconfiguration,
+//! release/redirect), which is exactly the foothold a false base station needs.
+//! This is the access-stratum counterpart to the NAS Security Mode Command
+//! selecting EIA0 that the `null_integrity` analyzer already flags; a CSS can
+//! drive either layer.
+//!
+//! The access stratum can select the integrity algorithm in two places, and
+//! this analyzer checks both:
+//! - a `SecurityModeCommand` (`securityConfigSMC`), the normal case; and
+//! - an `RRCConnectionReconfiguration` carrying `securityConfigHO` -- a handover
+//!   (intra-LTE or inter-RAT to LTE) establishes AS algorithms without a
+//!   separate Security Mode Command, so a CSS could select EIA0 there too.
+//!
+//! The one legitimate use of EIA0 is an unauthenticated emergency call, where
+//! the network has no security context to integrity-protect with. The detector
+//! is therefore stateless and High but off by default: suppressing the
+//! emergency case needs connection state and is a separate, stateful follow-up,
+//! so until then an emergency call is a known false positive.
+//!
+//! Scope: operates on the RRC the Rayhunter DIAG pipeline delivers, matching the
+//! decoded DL-DCCH message directly.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use telcom_parser::lte_rrc::{
+    DL_DCCH_MessageType, DL_DCCH_MessageType_c1, RRCConnectionReconfigurationCriticalExtensions,
+    RRCConnectionReconfigurationCriticalExtensions_c1, SecurityAlgorithmConfig,
+    SecurityAlgorithmConfigIntegrityProtAlgorithm, SecurityConfigHOHandoverType,
+    SecurityModeCommandCriticalExtensions, SecurityModeCommandCriticalExtensions_c1,
+};
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct RrcNullIntegrityAnalyzer;
+
+/// True if the AS security algorithm config selects null integrity (EIA0).
+fn selects_eia0(algo: &SecurityAlgorithmConfig) -> bool {
+    algo.integrity_prot_algorithm.0 == SecurityAlgorithmConfigIntegrityProtAlgorithm::EIA0_V920
+}
+
+fn event(source: &str) -> Event {
+    Event {
+        event_type: EventType::High,
+        message: format!(
+            "{source} selected null integrity (EIA0) -- access-stratum signalling left \
+             unauthenticated"
+        ),
+    }
+}
+
+impl Analyzer for RrcNullIntegrityAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("RRC null integrity (EIA0)")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags an RRC configuration that selects the null integrity algorithm (EIA0), leaving \
+             access-stratum signalling unauthenticated -- the access-stratum counterpart to a NAS \
+             Security Mode Command selecting EIA0. Checks both a Security Mode Command \
+             (securityConfigSMC) and a handover RRCConnectionReconfiguration (securityConfigHO, \
+             intra-LTE or inter-RAT), since a handover establishes AS algorithms without a separate \
+             Security Mode Command. A false base station uses EIA0 so the UE will act on forged RRC. \
+             High. The one legitimate use is an unauthenticated emergency call, which a stateless \
+             detector cannot yet exclude, so it is off by default pending calibration and \
+             emergency-case suppression.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::DlDcch(msg) = lte.as_ref() else {
+            return None;
+        };
+        match &msg.message {
+            // Security Mode Command: securityConfigSMC -> securityAlgorithmConfig.
+            DL_DCCH_MessageType::C1(DL_DCCH_MessageType_c1::SecurityModeCommand(smc)) => {
+                let SecurityModeCommandCriticalExtensions::C1(
+                    SecurityModeCommandCriticalExtensions_c1::SecurityModeCommand_r8(r8),
+                ) = &smc.critical_extensions
+                else {
+                    return None;
+                };
+                selects_eia0(&r8.security_config_smc.security_algorithm_config)
+                    .then(|| event("RRC Security Mode Command"))
+            }
+            // Handover reconfiguration: securityConfigHO -> handoverType ->
+            // securityAlgorithmConfig (present always for inter-RAT, optionally
+            // for intra-LTE).
+            DL_DCCH_MessageType::C1(DL_DCCH_MessageType_c1::RrcConnectionReconfiguration(
+                reconf,
+            )) => {
+                let RRCConnectionReconfigurationCriticalExtensions::C1(
+                    RRCConnectionReconfigurationCriticalExtensions_c1::RrcConnectionReconfiguration_r8(r8),
+                ) = &reconf.critical_extensions
+                else {
+                    return None;
+                };
+                let algo = match &r8.security_config_ho.as_ref()?.handover_type {
+                    SecurityConfigHOHandoverType::IntraLTE(intra) => {
+                        intra.security_algorithm_config.as_ref()?
+                    }
+                    SecurityConfigHOHandoverType::InterRAT(inter) => {
+                        &inter.security_algorithm_config
+                    }
+                };
+                selects_eia0(algo).then(|| event("RRC handover reconfiguration"))
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, dl_dcch, packet_time};
+
+    fn hex(s: &str) -> Vec<u8> {
+        assert_eq!(s.len() % 2, 0, "odd-length hex vector");
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    // DL-DCCH PDUs encoded with the reference Python pycrate (TS 36.331) and
+    // decoded here through telcom_parser.
+    // SecurityModeCommand: integrityProtAlgorithm = eia0 / eia2.
+    const SMC_EIA0: &str = "300000";
+    const SMC_EIA2: &str = "300020";
+    // RRCConnectionReconfiguration with securityConfigHO selecting EIA0:
+    // intra-LTE and inter-RAT handover; plus an intra-LTE EIA2 and a reconfig
+    // with no securityConfigHO (both benign).
+    const RECONF_HO_INTRA_EIA0: &str = "20011000";
+    const RECONF_HO_INTER_EIA0: &str = "20012000000000000000";
+    const RECONF_HO_INTRA_EIA2: &str = "20011020";
+    const RECONF_NO_HO: &str = "200000";
+    // A benign DL-DCCH DLInformationTransfer (the T-OR-112 real vector).
+    const BENIGN_DLDCCH: &str = "0a00183a2040074408";
+
+    fn run(v: &str) -> Vec<(usize, Event)> {
+        let mut a = RrcNullIntegrityAnalyzer;
+        collect_events(&mut a, &[(dl_dcch(&hex(v)), packet_time(0))])
+    }
+
+    #[test]
+    fn security_mode_command_with_eia0_is_high() {
+        let events = run(SMC_EIA0);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+        assert!(events[0].1.message.contains("EIA0"));
+        assert!(events[0].1.message.contains("Security Mode Command"));
+    }
+
+    #[test]
+    fn handover_reconfiguration_with_eia0_is_high() {
+        for v in [RECONF_HO_INTRA_EIA0, RECONF_HO_INTER_EIA0] {
+            let events = run(v);
+            assert_eq!(events.len(), 1, "{v}");
+            assert_eq!(events[0].1.event_type, EventType::High, "{v}");
+            assert!(events[0].1.message.contains("handover"), "{v}");
+        }
+    }
+
+    #[test]
+    fn a_real_integrity_algorithm_is_ignored() {
+        assert!(run(SMC_EIA2).is_empty());
+        assert!(run(RECONF_HO_INTRA_EIA2).is_empty());
+    }
+
+    #[test]
+    fn reconfiguration_without_security_config_ho_is_ignored() {
+        assert!(run(RECONF_NO_HO).is_empty());
+    }
+
+    #[test]
+    fn unrelated_dl_dcch_is_ignored() {
+        assert!(run(BENIGN_DLDCCH).is_empty());
+    }
+
+    #[test]
+    fn non_lte_information_element_is_ignored() {
+        let mut a = RrcNullIntegrityAnalyzer;
+        assert!(collect_events(&mut a, &[(InformationElement::GSM, packet_time(0))]).is_empty());
+    }
+}
