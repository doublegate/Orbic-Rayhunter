+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use chrono::DateTime;
+
+    #[test]
+    fn process_row_records_skip_reason_and_event() {
+        let mut report = Report::new("test");
+        report.process_row(
+            AnalysisRow {
+                packet_timestamp: Some(
+                    DateTime::parse_from_rfc3339("2025-01-01T00:00:00+00:00").unwrap(),
+                ),
+                skipped_message_reason: Some("parse error".to_string()),
+                events: vec![Some(Event {
+                    event_type: EventType::Low,
+                    message: "warning".to_string(),
+                })],
+            },
+            &["TestAnalyzer".to_string()],
+        );
+
+        assert_eq!(report.skipped, 1);
+        assert_eq!(report.skipped_reasons["parse error"], 1);
+        assert_eq!(report.warnings, 1);
+        assert_eq!(report.events.len(), 1);
+        assert_eq!(report.events[0].analyzer, "TestAnalyzer");
+        // A non-identity analyzer does not count toward identity exposure.
+        assert!(report.identity_exposure.is_empty());
+    }
+
+    fn id_row(ts: &str, msg: &str) -> AnalysisRow {
+        AnalysisRow {
+            packet_timestamp: Some(DateTime::parse_from_rfc3339(ts).unwrap()),
+            skipped_message_reason: None,
+            events: vec![Some(Event {
+                event_type: EventType::Medium,
+                message: msg.to_string(),
+            })],
+        }
+    }
+
+    #[test]
+    fn identity_exposure_tally_counts_only_identity_analyzers() {
+        let mut report = Report::new("test");
+        // Two identity-exposure analyzers fire; a non-identity one does not count.
+        report.process_row(
+            id_row("2025-01-01T00:00:00+00:00", "imsi"),
+            &["Permanent identity disclosure".to_string()],
+        );
+        report.process_row(
+            id_row("2025-01-01T00:00:01+00:00", "imsi again"),
+            &["Permanent identity disclosure".to_string()],
+        );
+        report.process_row(
+            id_row("2025-01-01T00:00:02+00:00", "paged"),
+            &["IMSI paging".to_string()],
+        );
+        report.process_row(
+            id_row("2025-01-01T00:00:03+00:00", "downgrade"),
+            &["Inter-RAT downgrade".to_string()],
+        );
+
+        assert_eq!(report.identity_exposure["Permanent identity disclosure"], 2);
+        assert_eq!(report.identity_exposure["IMSI paging"], 1);
+        assert_eq!(report.identity_exposure.len(), 2);
+        assert!(!report.identity_exposure.contains_key("Inter-RAT downgrade"));
+    }
+
+    #[test]
+    fn identity_exposure_names_match_real_analyzer_names() {
+        // Guard against a typo or an upstream rename silently zeroing the tally:
+        // every name in IDENTITY_EXPOSURE_ANALYZERS must be a real analyzer name
+        // in a harness with those analyzers enabled. (AnalyzerConfig, Harness and
+        // DeviceMetadata come from `use super::*`.)
+        let config = AnalyzerConfig {
+            imsi_requested: true,
+            identity_disclosure: true,
+            imsi_paging: true,
+            ..Default::default()
+        };
+        let harness = Harness::new_with_config(&config, &DeviceMetadata::default());
+        let names = analyzer_names(&harness);
+        for expected in IDENTITY_EXPOSURE_ANALYZERS {
+            assert!(
+                names.iter().any(|n| n == expected),
+                "IDENTITY_EXPOSURE_ANALYZERS entry {expected:?} does not match any analyzer name; \
+                 an analyzer was renamed",
+            );
+        }
+    }
+
+    #[test]
+    fn identity_exposure_seeds_zero_for_enabled_analyzers() {
+        // An enabled-but-clean recording keeps explicit 0 entries (distinct from
+        // an unmonitored recording, where the keys are absent).
+        let mut report = Report::new("test");
+        report.seed_identity_exposure(&[
+            "IMSI paging".to_string(),
+            "Inter-RAT downgrade".to_string(),
+        ]);
+        assert_eq!(report.identity_exposure.get("IMSI paging"), Some(&0));
+        assert!(!report.identity_exposure.contains_key("Inter-RAT downgrade"));
+    }
+
+    #[test]
+    fn identity_exposure_counts_informational_events_too() {
+        // The tally counts any event from an exposure analyzer, regardless of
+        // severity (these analyzers emit warning-level events, but the count is
+        // not gated on severity, unlike `warnings`).
+        let mut report = Report::new("test");
+        let mut row = id_row("2025-01-01T00:00:00+00:00", "info exposure");
+        row.events[0].as_mut().unwrap().event_type = EventType::Informational;
+        report.process_row(row, &["IMSI paging".to_string()]);
+        assert_eq!(report.identity_exposure["IMSI paging"], 1);
+        assert_eq!(report.warnings, 0, "Informational is not a warning");
+    }
+}
