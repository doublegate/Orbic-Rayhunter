diff --git a/lib/src/analysis/identity_disclosure.rs b/lib/src/analysis/identity_disclosure.rs
new file mode 100644
index 0000000..79d17ad
--- /dev/null
+++ b/lib/src/analysis/identity_disclosure.rs
@@ -0,0 +1,220 @@
+//! Flags the UE disclosing a permanent subscriber or device identity in the
+//! clear over NAS -- the other half of an IMSI-catcher's identification step.
+//!
+//! Upstream's `imsi_requested` analyzer watches the *request* side (the network
+//! sending an `Identity Request`, and the stateful request-without-auth
+//! sequence). This analyzer watches the *response* side: whether the UE
+//! actually surrendered a permanent identity, which is the disclosure that
+//! matters for the subscriber.
+//!
+//! - `Identity Response` carrying an **IMSI** (TS 24.301 5.4.4): the permanent
+//!   subscriber identity was sent in the clear. A legitimate network requests
+//!   the IMSI only when it has no valid GUTI/temporary identity for the UE;
+//!   an IMSI-catcher requests it precisely to identify the subscriber. Medium,
+//!   because the disclosure alone does not prove intent -- the stateful
+//!   `imsi_requested` analyzer judges the home-network/no-authentication
+//!   context that raises it to an attack signal.
+//! - `Identity Response` carrying an **IMEI/IMEISV**: the permanent *device*
+//!   identity. A network has almost no legitimate need to pull the IMEI through
+//!   the NAS identity procedure, so this is a stronger signal (High).
+//! - `Attach Request` whose EPS mobile identity is an **IMSI** rather than a
+//!   GUTI: the UE attached with its permanent identity. This is what a CSS
+//!   forces by rejecting an attach with an identity-wiping cause (see
+//!   `nas_reject`), but it is also how a UE with no valid GUTI attaches
+//!   legitimately, so it is Low on its own.
+//!
+//! Stateless: keys on the message and the identity *type* only. It never reads
+//! the identity digits -- per docs/ANALYZERS.md the decoded IMSI/IMEI value
+//! must never reach an `Event`, so the messages name the identity type alone.
+//! Off by default pending per-network calibration: a UE with no stored GUTI
+//! discloses its IMSI on a genuine first attach, and an inactive/unprovisioned
+//! SIM (which cannot complete authentication) can be made to re-disclose it.
+//!
+//! Scope: operates on the plain/decrypted NAS the Rayhunter DIAG pipeline
+//! delivers, matching `NASMessage::EMMMessage` directly, like the other NAS
+//! analyzers here.
+
+use std::borrow::Cow;
+
+use chrono::{DateTime, FixedOffset};
+use pycrate_rs::nas::NASMessage;
+use pycrate_rs::nas::emm::EMMMessage;
+use pycrate_rs::nas::mobile_identity::IdentityType;
+
+use super::analyzer::{Analyzer, Event, EventType};
+use super::information_element::{InformationElement, LteInformationElement};
+
+pub struct IdentityDisclosureAnalyzer;
+
+impl Analyzer for IdentityDisclosureAnalyzer {
+    fn get_name(&self) -> Cow<'_, str> {
+        Cow::from("Permanent identity disclosure")
+    }
+
+    fn get_description(&self) -> Cow<'_, str> {
+        Cow::from(
+            "Flags the UE disclosing a permanent identity over NAS: an Identity Response carrying \
+             the IMSI (Medium) or the IMEI/IMEISV device identity (High), or an Attach Request that \
+             uses the IMSI as its EPS mobile identity instead of a GUTI (Low). An IMSI-catcher \
+             requests the permanent identity to identify the subscriber; this analyzer confirms the \
+             UE surrendered it. It complements the request-side imsi_requested analyzer and keys on \
+             the message and identity type alone -- never the identity digits. A UE with no stored \
+             GUTI discloses its IMSI on a genuine first attach, so this is off by default pending \
+             per-network calibration.",
+        )
+    }
+
+    fn get_version(&self) -> u32 {
+        0
+    }
+
+    fn analyze_information_element(
+        &mut self,
+        ie: &InformationElement,
+        _packet_num: usize,
+        _timestamp: DateTime<FixedOffset>,
+    ) -> Option<Event> {
+        let InformationElement::LTE(lte) = ie else {
+            return None;
+        };
+        let LteInformationElement::NAS(NASMessage::EMMMessage(emm)) = lte.as_ref() else {
+            return None;
+        };
+        match emm {
+            EMMMessage::EMMIdentityResponse(resp) => match resp.id.inner.identity_type() {
+                IdentityType::Imsi => Some(Event {
+                    event_type: EventType::Medium,
+                    message: "Identity Response disclosed the IMSI (permanent subscriber identity)"
+                        .to_string(),
+                }),
+                IdentityType::Imei | IdentityType::Imeisv => Some(Event {
+                    event_type: EventType::High,
+                    message: "Identity Response disclosed the IMEI/IMEISV (permanent device \
+                              identity) -- a network rarely needs this via the NAS identity \
+                              procedure"
+                        .to_string(),
+                }),
+                _ => None,
+            },
+            EMMMessage::EMMAttachRequest(req) => {
+                if req.epsid.inner.identity_type() == IdentityType::Imsi {
+                    Some(Event {
+                        event_type: EventType::Low,
+                        message: "Attach Request used the IMSI as its EPS mobile identity instead \
+                                  of a GUTI"
+                            .to_string(),
+                    })
+                } else {
+                    None
+                }
+            }
+            _ => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::analysis::test_util::{collect_events, emm_message, packet_time};
+
+    // EMM message type identifiers (TS 24.301 table 9.8.1).
+    const ATTACH_REQUEST: u8 = 65;
+    const IDENTITY_RESPONSE: u8 = 86;
+
+    // Mobile-identity IE values for the Identity Response (the LV length byte is
+    // added by `id_response`). Synthetic test identities only (test PLMN 001/01).
+    const IMSI: &str = "0910101032547698"; // type 001, 15 digits
+    const IMEISV: &str = "3355140216325406f1"; // 24.008 type 011, IMEISV
+    const GUTI_IE: &str = "f600f11080010112345678"; // type 110, must not flag
+
+    // Full Attach Request bodies (after the 07/41 header `emm_message` prepends).
+    // GUTI_ATTACH is the real device vector from the pycrate fork tests; its EPS
+    // mobile identity is a GUTI. IMSI_ATTACH replaces only that identity's LV
+    // (`0b` + 11-byte GUTI) with an 8-byte IMSI (`08` + IMSI), keeping the rest
+    // of the message, so the two differ only in the identity type.
+    const ATTACH_TAIL: &str = "05f07000001000360201d031d1272f8080211001000010810600000000830600000000000d00000300ff0003130184000100000c00000a00000500001000521301846a025c0a009011034f18a6f15d0103c1000000000000";
+
+    fn hex(s: &str) -> Vec<u8> {
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    /// An Identity Response (0x56) whose mobile identity is the LV `value`.
+    fn id_response(value_hex: &str) -> Vec<(usize, Event)> {
+        let v = hex(value_hex);
+        let mut body = vec![v.len() as u8];
+        body.extend_from_slice(&v);
+        let mut analyzer = IdentityDisclosureAnalyzer;
+        collect_events(
+            &mut analyzer,
+            &[(emm_message(IDENTITY_RESPONSE, &body), packet_time(0))],
+        )
+    }
+
+    fn attach_request(body_hex: &str) -> Vec<(usize, Event)> {
+        let mut analyzer = IdentityDisclosureAnalyzer;
+        collect_events(
+            &mut analyzer,
+            &[(emm_message(ATTACH_REQUEST, &hex(body_hex)), packet_time(0))],
+        )
+    }
+
+    #[test]
+    fn identity_response_imsi_is_medium() {
+        let events = id_response(IMSI);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Medium);
+        assert!(events[0].1.message.contains("IMSI"));
+        // never the digits
+        assert!(!events[0].1.message.contains("001010123456789"));
+    }
+
+    #[test]
+    fn identity_response_imeisv_is_high() {
+        let events = id_response(IMEISV);
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::High);
+        assert!(events[0].1.message.contains("IMEI"));
+    }
+
+    #[test]
+    fn identity_response_guti_is_ignored() {
+        // A temporary identity in an Identity Response is not a disclosure.
+        assert!(id_response(GUTI_IE).is_empty());
+    }
+
+    #[test]
+    fn attach_request_with_imsi_is_low() {
+        let events = attach_request(&format!("0208{IMSI}{ATTACH_TAIL}"));
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].1.event_type, EventType::Low);
+        assert!(events[0].1.message.contains("IMSI"));
+    }
+
+    #[test]
+    fn attach_request_with_guti_is_ignored() {
+        // The common case: the real device vector attaches with a GUTI.
+        let guti_attach = format!("020bf6130184fa6ab2c05ff062{ATTACH_TAIL}");
+        assert!(attach_request(&guti_attach).is_empty());
+    }
+
+    #[test]
+    fn unrelated_emm_message_is_ignored() {
+        // An Authentication Reject (type 84) is EMM but not an identity message.
+        let mut analyzer = IdentityDisclosureAnalyzer;
+        assert!(
+            collect_events(&mut analyzer, &[(emm_message(84, &[]), packet_time(0))]).is_empty()
+        );
+    }
+
+    #[test]
+    fn non_lte_information_element_is_ignored() {
+        let mut analyzer = IdentityDisclosureAnalyzer;
+        assert!(
+            collect_events(&mut analyzer, &[(InformationElement::GSM, packet_time(0))]).is_empty()
+        );
+    }
+}
